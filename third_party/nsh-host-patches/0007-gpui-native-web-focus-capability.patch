+        // `webview.nativeFocus`: resolves true. This host carries out a web
+        // view's `focus()` / `blur()` and takes the keyboard back from a web
+        // view on a press of the app's content (patches 0001, 0002); a host
+        // without them rejects the call, and the app keeps its workarounds.
+        theme_host.handle("webview.nativeFocus", |call| {
+            call.resolve(serde_json::Value::Bool(true));
+        });
