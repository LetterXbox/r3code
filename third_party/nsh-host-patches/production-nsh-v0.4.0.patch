+// NSH backdrop passes sample only already-painted pixels. Horizontal output is
+// expanded around the card so the vertical pass never samples uninitialized data.
+struct NshBackdropVertex { float4 position [[position]]; };
+vertex NshBackdropVertex nsh_backdrop_vertex(uint index [[vertex_id]], constant float2 *vertices [[buffer(0)]]) {
+  float2 p = vertices[index];
+  return NshBackdropVertex{float4(p.x * 2.0 - 1.0, 1.0 - p.y * 2.0, 0.0, 1.0)};
+}
+fragment float4 nsh_backdrop_fragment(NshBackdropVertex in [[stage_in]], constant float4 *args [[buffer(0)]], texture2d<float> source [[texture(0)]]) {
+  constexpr sampler sample_filter(coord::normalized, address::clamp_to_edge, filter::linear);
+  float2 extent = float2(source.get_width(), source.get_height());
+  float2 direction = args[2].z > 0.5 ? float2(0,1) : float2(1,0);
+  float4 color = float4(0.0);
+  float total = 0.0;
+  // Fixed pixel spacing avoids a comb of readable text copies at large radii.
+  // Linear sampling combines adjacent pixels into each two-pixel tap.
+  float sigma = max(args[2].x, 0.5);
+  int sample_radius = int(ceil(sigma * 3.0));
+  for (int i = -sample_radius; i <= sample_radius; i += 2) {
+    float offset = float(i) + 0.5;
+    float normalized = offset / sigma;
+    float weight = exp(-0.5 * normalized * normalized);
+    color += source.sample(sample_filter, (in.position.xy + direction * offset) / extent) * weight;
+    total += weight;
+  }
+  color /= total;
+  if (args[2].z < 0.5) return color;
+  float2 local = in.position.xy - args[0].xy - args[0].zw * 0.5;
+  float radius = local.x < 0.0 ? (local.y < 0.0 ? args[1].x : args[1].w) : (local.y < 0.0 ? args[1].y : args[1].z);
+  float2 q = abs(local) - args[0].zw * 0.5 + radius;
+  float distance = length(max(q, float2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
+  float coverage = clamp(0.5 - distance, 0.0, 1.0);
+  if (color.a > 0.0001) color.rgb /= color.a;
+  float luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
+  color.rgb = mix(float3(luma), color.rgb, args[2].y);
+  color.a *= coverage;
+  return color;
+}
