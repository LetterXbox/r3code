+/// Makes the surface's view the window's first responder again when a
+/// native child view (a web view the user clicked into) holds it: GPUI's
+/// view takes it only when the window is made, so without this the keys
+/// keep going to the web view after the app's content is pressed or one
+/// of its fields focused.
+pub(crate) fn take_first_responder(_window: &Window) {
+    #[cfg(target_os = "macos")]
+    {
+        use objc2_app_kit::NSView;
+        use raw_window_handle::{HasWindowHandle, RawWindowHandle};
+
+        if let Ok(handle) = HasWindowHandle::window_handle(_window)
+            && let RawWindowHandle::AppKit(handle) = handle.as_raw()
+        {
+            // SAFETY: GPUI owns this live NSView, and window updates run on
+            // AppKit's main thread. The borrowed reference stays in this call.
+            let view = unsafe { &*handle.ns_view.as_ptr().cast::<NSView>() };
+            if let Some(window) = view.window() {
+                let ours = window.firstResponder().is_some_and(|r| {
+                    std::ptr::eq((&*r as *const objc2_app_kit::NSResponder).cast::<NSView>(), view)
+                });
+                if !ours {
+                    window.makeFirstResponder(Some(&**view));
+                }
+            }
+        }
+    }
+}
