@@ -0,0 +1,287 @@
+//! Same-frame, separable Gaussian backdrop blur. The private -8 hue effect
+//! quad is emitted before a translucent NSH surface, using the same reserved
+//! quad mechanism as the renderer's destination-out webview holes.
+use super::{MetalRenderer, new_command_encoder_for_texture};
+use gpui::{DevicePixels, Quad, Size};
+use metal::{MTLPixelFormat, MTLTextureUsage};
+use std::mem;
+
+pub(super) fn is_backdrop_quad(quad: &Quad) -> bool {
+    quad.border_color.h == -8.0 && quad.border_color.a == 0.0
+}
+
+pub(super) fn pipeline(
+    device: &metal::DeviceRef,
+    library: &metal::LibraryRef,
+    blend: bool,
+) -> metal::RenderPipelineState {
+    let descriptor = metal::RenderPipelineDescriptor::new();
+    descriptor.set_label("nsh backdrop blur");
+    let vertex = library
+        .get_function("nsh_backdrop_vertex", None)
+        .expect("backdrop vertex shader");
+    let fragment = library
+        .get_function("nsh_backdrop_fragment", None)
+        .expect("backdrop fragment shader");
+    descriptor.set_vertex_function(Some(&vertex));
+    descriptor.set_fragment_function(Some(&fragment));
+    let color = descriptor
+        .color_attachments()
+        .object_at(0)
+        .expect("color attachment");
+    color.set_pixel_format(MTLPixelFormat::BGRA8Unorm);
+    color.set_blending_enabled(blend);
+    if blend {
+        color.set_source_rgb_blend_factor(metal::MTLBlendFactor::SourceAlpha);
+        color.set_destination_rgb_blend_factor(metal::MTLBlendFactor::OneMinusSourceAlpha);
+        color.set_source_alpha_blend_factor(metal::MTLBlendFactor::One);
+        color.set_destination_alpha_blend_factor(metal::MTLBlendFactor::OneMinusSourceAlpha);
+    }
+    device
+        .new_render_pipeline_state(&descriptor)
+        .expect("backdrop pipeline")
+}
+
+fn scissor(bounds: [f32; 4], padding: f32, width: u64, height: u64) -> metal::MTLScissorRect {
+    let left = (bounds[0] - padding).floor().clamp(0.0, width as f32) as u64;
+    let top = (bounds[1] - padding).floor().clamp(0.0, height as f32) as u64;
+    let right = (bounds[0] + bounds[2] + padding)
+        .ceil()
+        .clamp(left as f32, width as f32) as u64;
+    let bottom = (bounds[1] + bounds[3] + padding)
+        .ceil()
+        .clamp(top as f32, height as f32) as u64;
+    metal::MTLScissorRect {
+        x: left,
+        y: top,
+        width: right - left,
+        height: bottom - top,
+    }
+}
+
+impl MetalRenderer {
+    pub(super) fn draw_backdrop(
+        &mut self,
+        quad: &Quad,
+        command: &metal::CommandBufferRef,
+        target: &metal::TextureRef,
+        viewport: Size<DevicePixels>,
+    ) {
+        let width = target.width();
+        let height = target.height();
+        let sigma = quad.border_color.s.clamp(0.1, 128.0);
+        let saturation = quad.border_color.l.clamp(0.0, 4.0);
+        if self
+            .backdrop_textures
+            .as_ref()
+            .is_none_or(|(a, _)| a.width() != width || a.height() != height)
+        {
+            let descriptor = metal::TextureDescriptor::new();
+            descriptor.set_texture_type(metal::MTLTextureType::D2);
+            descriptor.set_pixel_format(MTLPixelFormat::BGRA8Unorm);
+            descriptor.set_width(width);
+            descriptor.set_height(height);
+            descriptor.set_storage_mode(metal::MTLStorageMode::Private);
+            descriptor.set_usage(MTLTextureUsage::ShaderRead | MTLTextureUsage::RenderTarget);
+            self.backdrop_textures = Some((
+                self.device.new_texture(&descriptor),
+                self.device.new_texture(&descriptor),
+            ));
+        }
+        let Some((source, horizontal)) = self.backdrop_textures.as_ref() else {
+            return;
+        };
+        let blit = command.new_blit_command_encoder();
+        blit.copy_from_texture(
+            target,
+            0,
+            0,
+            metal::MTLOrigin { x: 0, y: 0, z: 0 },
+            metal::MTLSize {
+                width,
+                height,
+                depth: 1,
+            },
+            source,
+            0,
+            0,
+            metal::MTLOrigin { x: 0, y: 0, z: 0 },
+        );
+        blit.end_encoding();
+        let bounds = [
+            quad.bounds.origin.x.0,
+            quad.bounds.origin.y.0,
+            quad.bounds.size.width.0,
+            quad.bounds.size.height.0,
+        ];
+        let radii = [
+            quad.corner_radii.top_left.0,
+            quad.corner_radii.top_right.0,
+            quad.corner_radii.bottom_right.0,
+            quad.corner_radii.bottom_left.0,
+        ];
+        let clip = quad.bounds.intersect(&quad.content_mask.bounds);
+        let clip = [
+            clip.origin.x.0,
+            clip.origin.y.0,
+            clip.size.width.0,
+            clip.size.height.0,
+        ];
+        for vertical in [false, true] {
+            let output = if vertical {
+                target
+            } else {
+                horizontal.as_ref()
+            };
+            let input = if vertical {
+                horizontal.as_ref()
+            } else {
+                source.as_ref()
+            };
+            let encoder = new_command_encoder_for_texture(command, output, viewport, None);
+            encoder.set_render_pipeline_state(if vertical {
+                &self.backdrop_pipeline_state
+            } else {
+                &self.backdrop_replace_pipeline_state
+            });
+            encoder.set_vertex_buffer(0, Some(&self.unit_vertices), 0);
+            let parameters = [
+                bounds,
+                radii,
+                [sigma, saturation, if vertical { 1.0 } else { 0.0 }, 0.0],
+            ];
+            encoder.set_fragment_bytes(
+                0,
+                mem::size_of_val(&parameters) as u64,
+                parameters.as_ptr().cast(),
+            );
+            encoder.set_fragment_texture(0, Some(input));
+            let rect = scissor(
+                if vertical { clip } else { bounds },
+                if vertical { 1.0 } else { sigma * 4.0 + 2.0 },
+                width,
+                height,
+            );
+            if rect.width > 0 && rect.height > 0 {
+                encoder.set_scissor_rect(rect);
+                encoder.draw_primitives(metal::MTLPrimitiveType::Triangle, 0, 6);
+            }
+            encoder.end_encoding();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn scissor_stays_inside_texture() {
+        let rect = scissor([-10.0, 10.0, 200.0, 100.0], 40.0, 100, 80);
+        assert_eq!((rect.x, rect.y, rect.width, rect.height), (0, 0, 100, 80));
+    }
+    #[test]
+    fn backdrop_blurs_previous_pixels_without_blurring_foreground() {
+        use gpui::{Bounds, ContentMask, Hsla, ScaledPixels, Scene, point, size};
+        use parking_lot::Mutex;
+        use std::sync::Arc;
+        let bounds = |x, y, w, h| {
+            Bounds::new(
+                point(ScaledPixels(x), ScaledPixels(y)),
+                size(ScaledPixels(w), ScaledPixels(h)),
+            )
+        };
+        let canvas = bounds(0.0, 0.0, 128.0, 128.0);
+        let make = |area, color: Hsla| Quad {
+            bounds: area,
+            content_mask: ContentMask { bounds: canvas },
+            background: color.into(),
+            ..Quad::default()
+        };
+        let mut scene = Scene::default();
+        scene.insert_primitive(make(canvas, gpui::black()));
+        scene.insert_primitive(make(bounds(0.0, 0.0, 64.0, 128.0), gpui::white()));
+        let mut blur = make(bounds(16.0, 16.0, 96.0, 96.0), gpui::black());
+        blur.border_color = Hsla {
+            h: -8.0,
+            s: 4.0,
+            l: 1.0,
+            a: 0.0,
+        };
+        scene.insert_primitive(blur);
+        scene.insert_primitive(make(bounds(90.0, 90.0, 8.0, 8.0), gpui::red()));
+        scene.finish();
+        let mut renderer = MetalRenderer::new_headless(Arc::new(Mutex::new(
+            super::super::InstanceBufferPool::default(),
+        )));
+        let image = renderer
+            .render_scene_to_image(&scene, size(DevicePixels(128), DevicePixels(128)))
+            .expect("Metal render");
+        let edge = image.get_pixel(63, 64).0;
+        assert!(
+            edge[0] > 70 && edge[0] < 210,
+            "edge should be blurred, got {edge:?}"
+        );
+        assert!(
+            image.get_pixel(63, 8).0[0] > 245,
+            "pixels outside the card must stay sharp"
+        );
+        let foreground = image.get_pixel(94, 94).0;
+        assert!(
+            foreground[0] > 240 && foreground[1] < 10,
+            "foreground must stay sharp: {foreground:?}"
+        );
+    }
+    #[test]
+    fn large_radius_smooths_fine_stripes_without_repeated_edges() {
+        use gpui::{Bounds, ContentMask, Hsla, ScaledPixels, Scene, point, size};
+        use parking_lot::Mutex;
+        use std::sync::Arc;
+        let bounds = |x, y, w, h| {
+            Bounds::new(
+                point(ScaledPixels(x), ScaledPixels(y)),
+                size(ScaledPixels(w), ScaledPixels(h)),
+            )
+        };
+        let canvas = bounds(0.0, 0.0, 256.0, 128.0);
+        let mut scene = Scene::default();
+        for x in 0..128 {
+            scene.insert_primitive(Quad {
+                bounds: bounds(x as f32 * 2.0, 0.0, 2.0, 128.0),
+                content_mask: ContentMask { bounds: canvas },
+                background: if x % 2 == 0 {
+                    gpui::white()
+                } else {
+                    gpui::black()
+                }
+                .into(),
+                ..Quad::default()
+            });
+        }
+        scene.insert_primitive(Quad {
+            bounds: canvas,
+            content_mask: ContentMask { bounds: canvas },
+            background: gpui::black().into(),
+            border_color: Hsla {
+                h: -8.0,
+                s: 32.0,
+                l: 1.0,
+                a: 0.0,
+            },
+            ..Quad::default()
+        });
+        scene.finish();
+        let mut renderer = MetalRenderer::new_headless(Arc::new(Mutex::new(
+            super::super::InstanceBufferPool::default(),
+        )));
+        let image = renderer
+            .render_scene_to_image(&scene, size(DevicePixels(256), DevicePixels(128)))
+            .expect("Metal render");
+        for x in 110..146 {
+            let value = image.get_pixel(x, 64).0[0];
+            assert!(
+                (120..=136).contains(&value),
+                "fine stripes must become uniform at large blur radius: x={x}, value={value}"
+            );
+        }
+    }
+}
