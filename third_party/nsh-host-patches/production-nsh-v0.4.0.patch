new file mode 100644
index 000000000..8d743975f
--- /dev/null
+++ b/crates/nsh-base/src/diff/search.rs
@@ -0,0 +1,204 @@
+//! Find in the diff (`search`): the matches of a query in every row's
+//! text, as the T3 Code web app's CodeViewSearch finds them (literal or a
+//! regular expression, case-sensitive or not, whole words by its word
+//! separators), painted behind their text (the editor's amber) with the
+//! current one stronger, counted for the app (`onSearchChange`) and
+//! revealed by the ref (`revealSearchMatch`).
+
+use std::ops::Range;
+
+use nsh_core::prelude::*;
+
+use super::{DiffLayout, DiffSearchResult, DiffViewEvent, controller::Dv};
+
+/// CodeViewSearch's MAX_SEARCH_MATCHES.
+const MAX_SEARCH_MATCHES: usize = 100_000;
+/// CodeViewSearch's WORD_SEPARATORS (and whitespace).
+const WORD_SEPARATORS: &str = "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?";
+
+/// The editor's search amber.
+pub(crate) const MATCH: AdaptiveColor = AdaptiveColor::rgb(0xfbbf24, 0xd97706);
+
+/// The side of a row a match is in: a split row's old or new side, or a
+/// unified row's one line.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum MatchColumn {
+    Old,
+    New,
+    Both,
+}
+
+/// A match: its row, side and byte range in the line's text.
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) struct SearchMatch {
+    pub(crate) row: usize,
+    pub(crate) column: MatchColumn,
+    pub(crate) range: Range<usize>,
+}
+
+fn is_separator(c: char) -> bool {
+    c.is_whitespace() || WORD_SEPARATORS.contains(c)
+}
+
+/// The matches of `query` in `text`.
+pub(crate) fn find(text: &str, query: &str, case_sensitive: bool, whole_word: bool, regex: bool) -> Vec<Range<usize>> {
+    if query.is_empty() {
+        return Vec::new();
+    }
+    let pattern = if regex { query.to_string() } else { regex::escape(query) };
+    let Ok(re) = regex::RegexBuilder::new(&pattern).case_insensitive(!case_sensitive).build() else {
+        return Vec::new();
+    };
+    re.find_iter(text)
+        .filter(|m| !m.as_str().is_empty())
+        .filter(|m| {
+            if !whole_word {
+                return true;
+            }
+            let before = text[..m.start()].chars().next_back().is_none_or(is_separator);
+            let after = text[m.end()..].chars().next().is_none_or(is_separator);
+            before && after
+        })
+        .map(|m| m.range())
+        .collect()
+}
+
+impl Dv {
+    /// Recomputes the matches when the query, its options, the rows or the
+    /// layout change, and reports their count.
+    pub(crate) fn follow_search(&self) {
+        let dv = self.clone();
+        effect(move || {
+            dv.rev.get();
+            let query = dv.props.search.get();
+            let case_sensitive = dv.props.search_case_sensitive.get();
+            let whole_word = dv.props.search_whole_word.get();
+            let regex = dv.props.search_regex.get();
+            let split = dv.props.layout.get() == DiffLayout::Split;
+            let inline = dv.props.inline.get_untracked();
+            let mut found = Vec::new();
+            if let Some(query) = query.filter(|q| !q.is_empty()) {
+                let mut st = dv.st.borrow_mut();
+                let rows = st.rows.len();
+                'rows: for row in 0..rows {
+                    let Some((old, new)) = st.cells(row, inline) else { continue };
+                    let cells: Vec<(MatchColumn, &super::controller::RowCell)> = if split {
+                        vec![(MatchColumn::Old, &old), (MatchColumn::New, &new)]
+                    } else if new.kind == super::controller::Tint::Filler {
+                        vec![(MatchColumn::Both, &old)]
+                    } else {
+                        vec![(MatchColumn::Both, &new)]
+                    };
+                    for (column, cell) in cells {
+                        if cell.line.is_none() {
+                            continue;
+                        }
+                        let text: String = cell.spans.iter().map(|s| s.text.as_str()).collect();
+                        for range in find(&text, &query, case_sensitive, whole_word, regex) {
+                            found.push(SearchMatch { row, column, range });
+                            if found.len() >= MAX_SEARCH_MATCHES {
+                                break 'rows;
+                            }
+                        }
+                    }
+                }
+            }
+            let count = found.len() as u32;
+            *dv.search.borrow_mut() = found;
+            dv.search_rev.update(|r| *r += 1);
+            let result = DiffSearchResult { count };
+            if dv.search_reported.get() != Some(result) {
+                dv.search_reported.set(Some(result));
+                untracked(|| dv.emit(DiffViewEvent::SearchChange(result)));
+            }
+        });
+    }
+
+    /// The matches in `row`'s `column` (byte ranges), with whether each is
+    /// the current one.
+    pub(crate) fn row_matches(&self, row: usize, column: MatchColumn) -> Vec<(Range<usize>, bool)> {
+        let current = self.props.search_current.get().map(|c| c as usize);
+        self.search
+            .borrow()
+            .iter()
+            .enumerate()
+            .filter(|(_, m)| m.row == row && m.column == column)
+            .map(|(index, m)| (m.range.clone(), Some(index) == current))
+            .collect()
+    }
+
+    /// Scrolls match `index` to the middle of the view.
+    pub(crate) fn reveal_search_match(&self, index: usize) {
+        let Some(row) = self.search.borrow().get(index).map(|m| m.row) else {
+            return;
+        };
+        let y = {
+            let st = self.st.borrow();
+            st.geometry.top(row)
+        };
+        let half = self.viewport.get_untracked().height * 0.5;
+        self.scroll_to_y((y - half).max(Points::ZERO), None);
+    }
+}
+
+/// `spans` (one wrapped line's, starting `start` bytes into the line) cut
+/// at the matches' edges: each piece with no match, a match, or the current
+/// match.
+pub(crate) fn mark_spans(
+    spans: Vec<super::controller::Span>,
+    start: usize,
+    matches: &[(Range<usize>, bool)],
+) -> Vec<(super::controller::Span, u8)> {
+    if matches.is_empty() {
+        return spans.into_iter().map(|s| (s, 0)).collect();
+    }
+    let mut out = Vec::new();
+    let mut at = start;
+    for span in spans {
+        let end = at + span.text.len();
+        let mut cuts = vec![at, end];
+        for (range, _) in matches {
+            for edge in [range.start, range.end] {
+                if edge > at && edge < end && span.text.is_char_boundary(edge - at) {
+                    cuts.push(edge);
+                }
+            }
+        }
+        cuts.sort_unstable();
+        cuts.dedup();
+        for pair in cuts.windows(2) {
+            let (a, b) = (pair[0], pair[1]);
+            let mark = matches
+                .iter()
+                .find(|(range, _)| range.start <= a && b <= range.end)
+                .map(|(_, current)| if *current { 2 } else { 1 })
+                .unwrap_or(0);
+            out.push((
+                super::controller::Span {
+                    text: span.text[a - at..b - at].to_string(),
+                    token: span.token.clone(),
+                    changed: span.changed,
+                },
+                mark,
+            ));
+        }
+        at = end;
+    }
+    out
+}
+
+
+#[cfg(test)]
+mod tests {
+    use super::find;
+
+    #[test]
+    fn finds_literal_case_and_whole_words() {
+        assert_eq!(find("Foo foo food", "foo", false, false, false).len(), 3);
+        assert_eq!(find("Foo foo food", "foo", true, false, false).len(), 2);
+        assert_eq!(find("Foo foo food", "foo", false, true, false).len(), 2);
+        assert_eq!(find("a.b a+b", "a.b", false, false, false), vec![0..3]);
+        assert_eq!(find("a1 a22", "a\\d+", false, false, true), vec![0..2, 3..6]);
+        assert!(find("x", "(", false, false, true).is_empty());
+    }
+}
