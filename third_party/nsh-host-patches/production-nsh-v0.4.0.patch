+const BROWSER_CONTEXT_ID: &str = "t3-preview";
+
+/// A tab's key, `(threadId, tabId)`.
+pub(crate) type Key = (String, String);
+
+/// The bridge tab `injected_js_before` names, if any.
+pub(crate) fn tab_key(injected_js_before: Option<&str>) -> Option<Key> {
+    let js = injected_js_before?;
+    let start = js.find(MARKER)? + MARKER.len();
+    let end = start + js[start..].find("*/")?;
+    let v: Value = serde_json::from_str(js[start..end].trim()).ok()?;
+    let thread = v.get("threadId")?.as_str()?.trim().to_owned();
+    let tab = v.get("tabId")?.as_str()?.trim().to_owned();
+    (!thread.is_empty() && !tab.is_empty()).then_some((thread, tab))
+}
+
+/// The script a bridge tab runs at document start.
+pub(crate) fn emulator() -> String {
+    if let Ok(path) = std::env::var("T3GPUI_DESKTOP_BROWSER_JS")
+        && let Ok(js) = std::fs::read_to_string(path)
+    {
+        return js;
+    }
+    EMULATOR.to_owned()
+}
+
+// ---- The connection ----
+
+static WRITER: OnceLock<mpsc::Sender<String>> = OnceLock::new();
+static STREAM: Mutex<Option<UnixStream>> = Mutex::new(None);
+
+fn start() {
+    if WRITER.get().is_some() {
+        return;
+    }
+    let Ok(path) = std::env::var("T3GPUI_DESKTOP_BROWSER_SOCKET") else {
+        return;
+    };
+    let (tx, rx) = mpsc::channel::<String>();
+    if WRITER.set(tx).is_err() {
+        return;
+    }
+    std::thread::spawn(move || {
+        for line in rx {
+            let mut guard = STREAM.lock().unwrap_or_else(|e| e.into_inner());
+            if let Some(stream) = guard.as_mut()
+                && (stream.write_all(line.as_bytes()).is_err() || stream.write_all(b"\n").is_err())
+            {
+                *guard = None;
+            }
+        }
+    });
+    std::thread::spawn(move || {
+        loop {
+            if let Ok(stream) = UnixStream::connect(&path) {
+                if let Ok(writer) = stream.try_clone() {
+                    *STREAM.lock().unwrap_or_else(|e| e.into_inner()) = Some(writer);
+                    crate::rt::invoke(announce_all);
+                    for line in BufReader::new(stream).lines() {
+                        let Ok(line) = line else { break };
+                        crate::rt::invoke(move || command_line(&line));
+                    }
+                }
+                *STREAM.lock().unwrap_or_else(|e| e.into_inner()) = None;
+                crate::rt::invoke(drop_all_relays);
+            }
+            std::thread::sleep(Duration::from_millis(500));
+        }
+    });
+}
+
+fn emit(event: Value) {
+    if let Some(tx) = WRITER.get() {
+        let _ = tx.send(event.to_string());
+    }
+}
+
+// ---- Tabs ----
+
+#[derive(Clone, Copy, PartialEq)]
+enum Kind {
+    Browser,
+    Page,
+}
+
+struct Relay {
+    attached: bool,
+    sessions: HashMap<String, Kind>,
+    seq: u32,
+}
+
+impl Relay {
+    fn new() -> Self {
+        let mut sessions = HashMap::new();
+        sessions.insert(PAGE_SESSION_ID.to_owned(), Kind::Page);
+        Relay { attached: false, sessions, seq: 0 }
+    }
+}
+
+struct Tab {
+    key: Key,
+    webview: Rc<wry::WebView>,
+    wk: *mut AnyObject,
+    frame_id: String,
+    relay: Relay,
+    url: String,
+    loader_id: String,
+    pending_loader: Option<String>,
+    ready: bool,
+    /// Isolated worlds asked for on every new document.
+    worlds: Vec<String>,
+    /// The current document's contexts: (id, name; "" is the default).
+    contexts: Vec<(u64, String)>,
+    /// Page commands sent to the page: js id -> (CDP id, session).
+    js_pending: HashMap<u64, (Value, Option<String>)>,
+    /// Page commands waiting for a document.
+    queued: Vec<(u64, String, Value)>,
+    shown: Option<bool>,
+    /// The current document reached DOMContentLoaded / load.
+    dcl_seen: bool,
+    load_seen: bool,
+}
+
+thread_local! {
+    static TABS: RefCell<HashMap<Key, Tab>> = RefCell::new(HashMap::new());
+}
+static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+
+fn next() -> u64 {
+    NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
+}
+
+fn loader() -> String {
+    format!("T3LOADER{:024X}", next())
+}
+
+fn key_json(key: &Key) -> (Value, Value) {
+    (Value::String(key.0.clone()), Value::String(key.1.clone()))
+}
+
+fn emit_tab(kind: &str, key: &Key, extra: Option<(&str, Value)>) {
+    let (thread, tab) = key_json(key);
+    let mut event = json!({ "type": kind, "threadId": thread, "tabId": tab });
+    if let Some((k, v)) = extra {
+        event[k] = v;
+    }
+    emit(event);
+}
+
+/// A bridge tab's web view was made.
+pub(crate) fn attach(key: Key, webview: Rc<wry::WebView>, wk: *mut AnyObject) {
+    start();
+    let url = webview.url().unwrap_or_default();
+    TABS.with(|tabs| {
+        tabs.borrow_mut().insert(
+            key.clone(),
+            Tab {
+                frame_id: format!("T3FRAME{:025X}", next()),
+                key: key.clone(),
+                webview,
+                wk,
+                relay: Relay::new(),
+                url,
+                loader_id: loader(),
+                pending_loader: None,
+                ready: false,
+                worlds: Vec::new(),
+                contexts: Vec::new(),
+                js_pending: HashMap::new(),
+                queued: Vec::new(),
+                shown: None,
+                dcl_seen: false,
+                load_seen: false,
+            },
+        );
+    });
+    log::info!(target: "js", "desktop browser: attached {}/{}", key.0, key.1);
+    emit_tab("attached", &key, None);
+}
+
+/// A bridge tab's web view went away.
+pub(crate) fn detach(key: &Key, webview: &Rc<wry::WebView>) {
+    let removed = TABS.with(|tabs| {
+        let mut tabs = tabs.borrow_mut();
+        let same = tabs.get(key).is_some_and(|t| Rc::ptr_eq(&t.webview, webview));
+        same.then(|| tabs.remove(key)).flatten()
+    });
+    if removed.is_some() {
+        emit_tab("detached", key, None);
+    }
+}
+
+/// A bridge tab started or stopped showing.
+pub(crate) fn set_shown(key: &Key, shown: bool) {
+    let changed = TABS.with(|tabs| {
+        let mut tabs = tabs.borrow_mut();
+        let Some(tab) = tabs.get_mut(key) else { return false };
+        if tab.shown == Some(shown) {
+            return false;
+        }
+        tab.shown = Some(shown);
+        true
+    });
+    if changed {
+        emit_tab("shown", key, Some(("shown", Value::Bool(shown))));
+    }
+}
+
+fn announce_all() {
+    let keys: Vec<(Key, Option<bool>)> = TABS.with(|tabs| {
+        let mut tabs = tabs.borrow_mut();
+        tabs.values_mut()
+            .map(|t| {
+                t.relay = Relay::new();
+                (t.key.clone(), t.shown)
+            })
+            .collect()
+    });
+    for (key, shown) in keys {
+        emit_tab("attached", &key, None);
+        if let Some(shown) = shown {
+            emit_tab("shown", &key, Some(("shown", Value::Bool(shown))));
+        }
+    }
+}
+
+fn drop_all_relays() {
+    TABS.with(|tabs| {
+        for tab in tabs.borrow_mut().values_mut() {
+            tab.relay = Relay::new();
+        }
+    });
+}
+
+// ---- Commands from the server ----
+
+fn command_line(line: &str) {
+    let Ok(command) = serde_json::from_str::<Value>(line) else { return };
+    let kind = command.get("type").and_then(Value::as_str).unwrap_or("");
+    if kind == "turn" {
+        return;
+    }
+    let (Some(thread), Some(tab)) = (
+        command.get("threadId").and_then(Value::as_str),
+        command.get("tabId").and_then(Value::as_str),
+    ) else {
+        return;
+    };
+    let key = (thread.to_owned(), tab.to_owned());
+    match kind {
+        "release" => TABS.with(|tabs| {
+            if let Some(tab) = tabs.borrow_mut().get_mut(&key) {
+                tab.relay = Relay::new();
+            }
+        }),
+        "pointer" => {
+            let phase = command.get("phase").and_then(Value::as_str).unwrap_or("move");
+            let x = command.get("x").and_then(Value::as_f64).unwrap_or(0.0);
+            let y = command.get("y").and_then(Value::as_f64).unwrap_or(0.0);
+            let webview = TABS.with(|tabs| tabs.borrow().get(&key).map(|t| t.webview.clone()));
+            if let Some(webview) = webview {
+                let _ = webview.evaluate_script(&format!(
+                    "window.__t3cdp && __t3cdp.pointer({}, {x}, {y})",
+                    Value::String(phase.to_owned())
+                ));
+            }
+        }
+        "cdp" => {
+            let Some(message) = command.get("message").and_then(Value::as_str) else { return };
+            let Ok(cdp) = serde_json::from_str::<Value>(message) else { return };
+            cdp_command(&key, cdp);
+        }
+        _ => {}
+    }
+}
+
+fn send(key: &Key, message: Value) {
+    let (thread, tab) = key_json(key);
+    emit(json!({ "type": "cdp", "threadId": thread, "tabId": tab, "message": message.to_string() }));
+}
+
+fn reply(key: &Key, id: &Value, session: Option<&str>, result: Result<Value, String>) {
+    let mut message = match result {
+        Ok(result) => json!({ "id": id, "result": result }),
+        Err(error) => json!({ "id": id, "error": { "code": -32000, "message": error } }),
+    };
+    if let Some(session) = session {
+        message["sessionId"] = Value::String(session.to_owned());
+    }
+    send(key, message);
+}
+
+/// A page event, to every page session (Electron reports the page's own
+/// events with no session; CdpRelay fans them out).
+fn page_event(tab: &Tab, method: &str, params: Value) {
+    if !tab.relay.attached {
+        return;
+    }
+    for (id, kind) in &tab.relay.sessions {
+        if *kind == Kind::Page {
+            send(&tab.key, json!({ "method": method, "params": params, "sessionId": id }));
+        }
+    }
+}
+
+fn target_info(tab: &Tab) -> Value {
+    json!({
+        "targetId": tab.frame_id,
+        "type": "page",
+        "title": tab.webview_title(),
+        "url": tab.url,
+        "attached": true,
+        "canAccessOpener": false,
+        "browserContextId": BROWSER_CONTEXT_ID,
+    })
+}
+
+impl Tab {
+    fn webview_title(&self) -> String {
+        // SAFETY: a WKWebView message on the main thread; wry keeps it alive.
+        unsafe { ns_string(msg_send![self.wk, title]) }
+    }
+
+    fn frame(&self) -> Value {
+        let origin = origin_of(&self.url);
+        json!({
+            "id": self.frame_id,
+            "loaderId": self.loader_id,
+            "url": self.url,
+            "domainAndRegistry": "",
+            "securityOrigin": origin,
+            "mimeType": "text/html",
+            "adFrameStatus": { "adFrameType": "none" },
+            "secureContextType": "Secure",
+            "crossOriginIsolatedContextType": "NotIsolated",
+            "gatedAPIFeatures": [],
+        })
+    }
+
+    fn context(&self, id: u64, name: &str) -> Value {
+        json!({ "context": {
+            "id": id,
+            "origin": origin_of(&self.url),
+            "name": name,
+            "uniqueId": format!("t3ctx.{id}"),
+            "auxData": {
+                "isDefault": name.is_empty(),
+                "type": if name.is_empty() { "default" } else { "isolated" },
+                "frameId": self.frame_id,
+            },
+        } })
+    }
+}
+
+fn origin_of(url: &str) -> String {
+    match url.find("://") {
+        Some(i) if url.starts_with("http") || url.starts_with("file") => {
+            let rest = &url[i + 3..];
+            let host = rest.split('/').next().unwrap_or("");
+            format!("{}://{}", &url[..i], host)
+        }
+        _ => "://".to_owned(),
+    }
+}
+
+/// # Safety
+/// `s` is an `NSString` or null, on the main thread.
+unsafe fn ns_string(s: *mut AnyObject) -> String {
+    if s.is_null() {
+        return String::new();
+    }
+    // SAFETY: as the caller promises.
+    unsafe {
+        let utf8: *const std::ffi::c_char = msg_send![s, UTF8String];
+        if utf8.is_null() { String::new() } else { CStr::from_ptr(utf8).to_string_lossy().into_owned() }
+    }
+}
+
+const ACKNOWLEDGED: &[&str] = &[
+    "Target.setDiscoverTargets",
+    "Browser.grantPermissions",
+    "Browser.resetPermissions",
+    "Browser.cancelDownload",
+    "Browser.setDownloadBehavior",
+];
+
+fn cdp_command(key: &Key, cdp: Value) {
+    let Some(id) = cdp.get("id").cloned().filter(Value::is_number) else { return };
+    let Some(method) = cdp.get("method").and_then(Value::as_str).map(str::to_owned) else { return };
+    let params = cdp.get("params").cloned().unwrap_or_else(|| json!({}));
+    let session = cdp.get("sessionId").and_then(Value::as_str).map(str::to_owned);
+    TABS.with(|tabs| {
+        let mut tabs = tabs.borrow_mut();
+        let Some(tab) = tabs.get_mut(key) else { return };
+        let kind = session.as_ref().map(|s| tab.relay.sessions.get(s).copied());
+        let browser = matches!(kind, None | Some(Some(Kind::Browser)));
+        if browser {
+            browser_command(tab, &id, &method, &params, session.as_deref());
+        } else if kind == Some(None) {
+            reply(key, &id, session.as_deref(), Err(format!("Session with given id not found: {}", session.as_deref().unwrap_or(""))));
+        } else {
+            page_command(tab, id, &method, params, session);
+        }
+    });
+}
+
+fn browser_command(tab: &mut Tab, id: &Value, method: &str, params: &Value, session: Option<&str>) {
+    let key = tab.key.clone();
+    if ACKNOWLEDGED.contains(&method) {
+        reply(&key, id, session, Ok(json!({})));
+        return;
+    }
+    let result = match method {
+        "Browser.getVersion" => Ok(json!({
+            "protocolVersion": "1.3", "product": "WebKit", "revision": "", "userAgent": "WebKit", "jsVersion": "",
+        })),
+        "Target.getTargetInfo" => Ok(json!({ "targetInfo": {
+            "targetId": "browser", "type": "browser", "title": "", "url": "", "attached": true, "canAccessOpener": false,
+        } })),
+        "Target.getBrowserContexts" => Ok(json!({ "browserContextIds": [] })),
+        "Target.getTargets" => Ok(json!({ "targetInfos": [target_info(tab)] })),
+        "Target.attachToBrowserTarget" => {
+            tab.relay.seq += 1;
+            let s = format!("t3-preview-browser-{}", tab.relay.seq);
+            tab.relay.sessions.insert(s.clone(), Kind::Browser);
+            Ok(json!({ "sessionId": s }))
+        }
+        "Target.attachToTarget" => {
+            if params.get("targetId").and_then(Value::as_str) != Some(&tab.frame_id) {
+                Err("Only this preview tab's page can be attached.".to_owned())
+            } else {
+                tab.relay.seq += 1;
+                let s = format!("t3-preview-page-{}", tab.relay.seq);
+                tab.relay.sessions.insert(s.clone(), Kind::Page);
+                Ok(json!({ "sessionId": s }))
+            }
+        }
+        "Target.detachFromTarget" => {
+            if let Some(s) = params.get("sessionId").and_then(Value::as_str)
+                && s != PAGE_SESSION_ID
+            {
+                tab.relay.sessions.remove(s);
+            }
+            Ok(json!({}))
+        }
+        "Target.setAutoAttach" => {
+            if tab.relay.attached {
+                Ok(json!({}))
+            } else {
+                tab.relay.attached = true;
+                reply(&key, id, session, Ok(json!({})));
+                let announce = json!({ "method": "Target.attachedToTarget", "params": {
+                    "sessionId": PAGE_SESSION_ID, "targetInfo": target_info(tab), "waitingForDebugger": false,
+                } });
+                send(&key, announce);
+                return;
+            }
+        }
+        _ => Err(format!("Not supported for a desktop preview tab: {method}")),
+    };
+    reply(&key, id, session, result);
+}
+
+/// Page methods answered with `{}`: what WKWebView has no counterpart for,
+/// or what the shim does anyway.
+fn stub(method: &str) -> bool {
+    matches!(
+        method,
+        "Page.enable"
+            | "Page.disable"
+            | "Page.setLifecycleEventsEnabled"
+            | "Page.setInterceptFileChooserDialog"
+            | "Page.setBypassCSP"
+            | "Page.bringToFront"
+            | "Page.setDownloadBehavior"
+            | "Page.removeScriptToEvaluateOnNewDocument"
+            | "Runtime.runIfWaitingForDebugger"
+            | "Runtime.addBinding"
+            | "Target.setAutoAttach"
+            | "Emulation.setFocusEmulationEnabled"
+    ) || method.starts_with("Log.")
+        || method.starts_with("Network.")
+        || method.starts_with("Emulation.")
+        || method.starts_with("Fetch.")
+        || method.starts_with("Performance.")
+        || method.starts_with("Security.")
+        || method.starts_with("ServiceWorker.")
+        || method.starts_with("Inspector.")
+        || method == "DOM.enable"
+        || method == "CSS.enable"
+        || method == "Accessibility.enable"
+}
+
+fn page_command(tab: &mut Tab, id: Value, method: &str, params: Value, session: Option<String>) {
+    let key = tab.key.clone();
+    let s = session.as_deref();
+    match method {
+        "Runtime.enable" => {
+            reply(&key, &id, s, Ok(json!({})));
+            if tab.ready {
+                for (cid, name) in tab.contexts.clone() {
+                    send_to(tab, s, "Runtime.executionContextCreated", tab.context(cid, &name));
+                }
+            }
+        }
+        "Page.setLifecycleEventsEnabled" => {
+            // Chrome replays the current document's lifecycle before answering: a page loaded before Playwright
+            // connected must still reach `load`.
+            if tab.ready {
+                let ts = now();
+                let mut names = vec!["commit"];
+                if tab.dcl_seen {
+                    names.push("DOMContentLoaded");
+                }
+                if tab.load_seen {
+                    names.extend(["load", "networkAlmostIdle", "networkIdle"]);
+                }
+                for name in names {
+                    send_to(tab, s, "Page.lifecycleEvent", json!({ "frameId": tab.frame_id, "loaderId": tab.loader_id, "name": name, "timestamp": ts }));
+                }
+            }
+            reply(&key, &id, s, Ok(json!({})));
+        }
+        "Page.getFrameTree" => reply(&key, &id, s, Ok(json!({ "frameTree": { "frame": tab.frame(), "childFrames": [] } }))),
+        "Page.addScriptToEvaluateOnNewDocument" => {
+            if let Some(world) = params.get("worldName").and_then(Value::as_str)
+                && !world.is_empty()
+                && !tab.worlds.iter().any(|w| w == world)
+            {
+                // Its context comes with the next document (or Page.createIsolatedWorld now), as Chrome's.
+                tab.worlds.push(world.to_owned());
+            }
+            reply(&key, &id, s, Ok(json!({ "identifier": next().to_string() })));
+        }
+        "Page.createIsolatedWorld" => {
+            let name = params.get("worldName").and_then(Value::as_str).unwrap_or("").to_owned();
+            let cid = next();
+            tab.contexts.push((cid, name.clone()));
+            page_event(tab, "Runtime.executionContextCreated", tab.context(cid, &name));
+            reply(&key, &id, s, Ok(json!({ "executionContextId": cid })));
+        }
+        "Page.navigate" => {
+            let url = params.get("url").and_then(Value::as_str).unwrap_or("about:blank").to_owned();
+            let loader_id = loader();
+            tab.pending_loader = Some(loader_id.clone());
+            page_event(tab, "Page.frameStartedNavigating", json!({
+                "frameId": tab.frame_id, "url": url, "loaderId": loader_id, "navigationType": "differentDocument",
+            }));
+            page_event(tab, "Page.frameStartedLoading", json!({ "frameId": tab.frame_id }));
+            match tab.webview.load_url(&url) {
+                Ok(()) => reply(&key, &id, s, Ok(json!({ "frameId": tab.frame_id, "loaderId": loader_id, "isDownload": false }))),
+                Err(e) => reply(&key, &id, s, Ok(json!({ "frameId": tab.frame_id, "loaderId": loader_id, "errorText": e.to_string() }))),
+            }
+        }
+        "Page.reload" => {
+            let loader_id = loader();
+            tab.pending_loader = Some(loader_id.clone());
+            page_event(tab, "Page.frameStartedNavigating", json!({
+                "frameId": tab.frame_id, "url": tab.url, "loaderId": loader_id, "navigationType": "reload",
+            }));
+            page_event(tab, "Page.frameStartedLoading", json!({ "frameId": tab.frame_id }));
+            let result = tab.webview.reload().map(|_| json!({})).map_err(|e| e.to_string());
+            reply(&key, &id, s, result);
+        }
+        "Page.getNavigationHistory" => reply(&key, &id, s, Ok(history(tab))),
+        "Page.navigateToHistoryEntry" => {
+            let entry = params.get("entryId").and_then(Value::as_i64).unwrap_or(0);
+            let current = history(tab).get("currentIndex").and_then(Value::as_i64).unwrap_or(0);
+            let _ = tab.webview.evaluate_script(&format!("history.go({})", entry - current));
+            reply(&key, &id, s, Ok(json!({})));
+        }
+        "Page.resetNavigationHistory" | "Page.stopLoading" => {
+            if method == "Page.stopLoading" {
+                let _ = tab.webview.evaluate_script("window.stop()");
+            }
+            reply(&key, &id, s, Ok(json!({})));
+        }
+        "Page.captureScreenshot" => screenshot(tab, id, session),
+        _ if stub(method) => reply(&key, &id, s, Ok(json!({}))),
+        _ => {
+            let jid = next();
+            tab.js_pending.insert(jid, (id, session));
+            if tab.ready {
+                run_js(tab, jid, method, &params);
+            } else {
+                tab.queued.push((jid, method.to_owned(), params));
+            }
+        }
+    }
+}
+
+fn send_to(tab: &Tab, session: Option<&str>, method: &str, params: Value) {
+    let mut message = json!({ "method": method, "params": params });
+    if let Some(s) = session {
+        message["sessionId"] = Value::String(s.to_owned());
+    }
+    send(&tab.key, message);
+}
+
+fn run_js(tab: &Tab, jid: u64, method: &str, params: &Value) {
+    let js = format!(
+        "window.__t3cdp && __t3cdp.handle({jid}, {}, {})",
+        Value::String(method.to_owned()),
+        params
+    );
+    if let Err(e) = tab.webview.evaluate_script(&js) {
+        log::warn!(target: "js", "desktop browser: {e}");
+    }
+}
+
+fn history(tab: &Tab) -> Value {
+    // SAFETY: WKWebView / WKBackForwardList messages on the main thread;
+    // wry keeps the web view alive.
+    unsafe {
+        let list: *mut AnyObject = msg_send![tab.wk, backForwardList];
+        let item_json = |item: *mut AnyObject, index: usize| -> Value {
+            let url: *mut AnyObject = msg_send![item, URL];
+            let url = if url.is_null() { String::new() } else { ns_string(msg_send![url, absoluteString]) };
+            let title = ns_string(msg_send![item, title]);
+            json!({ "id": index, "url": url, "userTypedURL": url, "title": title, "transitionType": "typed" })
+        };
+        let mut entries = Vec::new();
+        let back: *mut AnyObject = msg_send![list, backList];
+        let n: usize = msg_send![back, count];
+        for i in 0..n {
+            let item: *mut AnyObject = msg_send![back, objectAtIndex: i];
+            entries.push(item_json(item, entries.len()));
+        }
+        let current_index = entries.len();
+        let current: *mut AnyObject = msg_send![list, currentItem];
+        if current.is_null() {
+            entries.push(json!({ "id": current_index, "url": tab.url, "userTypedURL": tab.url, "title": "", "transitionType": "typed" }));
+        } else {
+            entries.push(item_json(current, current_index));
+        }
+        let forward: *mut AnyObject = msg_send![list, forwardList];
+        let n: usize = msg_send![forward, count];
+        for i in 0..n {
+            let item: *mut AnyObject = msg_send![forward, objectAtIndex: i];
+            entries.push(item_json(item, entries.len()));
+        }
+        json!({ "currentIndex": current_index, "entries": entries })
+    }
+}
+
+/// `NSBitmapImageFileTypePNG`.
+const PNG: usize = 4;
+
+fn screenshot(tab: &Tab, id: Value, session: Option<String>) {
+    let key = tab.key.clone();
+    let webview = tab.webview.clone();
+    let wk = tab.wk;
+    let pending = Cell::new(Some((id, session)));
+    let block = RcBlock::new(move |image: *mut AnyObject, _error: *mut AnyObject| {
+        let _keep = &webview;
+        let Some((id, session)) = pending.take() else { return };
+        // SAFETY: AppKit messages on the main thread, on the image the
+        // completion handler hands over.
+        let data = unsafe {
+            if image.is_null() {
+                None
+            } else {
+                let tiff: *mut AnyObject = msg_send![image, TIFFRepresentation];
+                let rep: *mut AnyObject =
+                    if tiff.is_null() { std::ptr::null_mut() } else { msg_send![class!(NSBitmapImageRep), imageRepWithData: tiff] };
+                let props: *mut AnyObject = msg_send![class!(NSDictionary), dictionary];
+                let png: *mut AnyObject =
+                    if rep.is_null() { std::ptr::null_mut() } else { msg_send![rep, representationUsingType: PNG, properties: props] };
+                if png.is_null() { None } else { Some(ns_string(msg_send![png, base64EncodedStringWithOptions: 0usize])) }
+            }
+        };
+        let result = data.map(|d| json!({ "data": d })).ok_or_else(|| "The page could not be captured.".to_owned());
+        reply(&key, &id, session.as_deref(), result);
+    });
+    // SAFETY: as above; a nil configuration snapshots the visible page.
+    unsafe {
+        let config: *mut AnyObject = std::ptr::null_mut();
+        let _: () = msg_send![wk, takeSnapshotWithConfiguration: config, completionHandler: &*block];
+    }
+}
+
+// ---- Messages from the page ----
+
+/// A message the bridge tab's page posted (after [`IPC_PREFIX`]).
+pub(crate) fn page_message(key: &Key, body: &str) {
+    let Ok(m) = serde_json::from_str::<Value>(body) else { return };
+    TABS.with(|tabs| {
+        let mut tabs = tabs.borrow_mut();
+        let Some(tab) = tabs.get_mut(key) else { return };
+        match m.get("t").and_then(Value::as_str).unwrap_or("") {
+            "r" => {
+                let Some(jid) = m.get("id").and_then(Value::as_u64) else { return };
+                let Some((id, session)) = tab.js_pending.remove(&jid) else { return };
+                let mut message = match m.get("error") {
+                    Some(error) => json!({ "id": id, "error": error }),
+                    None => json!({ "id": id, "result": m.get("result").cloned().unwrap_or_else(|| json!({})) }),
+                };
+                if let Some(s) = session {
+                    message["sessionId"] = Value::String(s);
+                }
+                send(key, message);
+            }
+            "doc" => new_document(tab, m.get("url").and_then(Value::as_str).unwrap_or("").to_owned()),
+            "dcl" => {
+                tab.dcl_seen = true;
+                let ts = now();
+                page_event(tab, "Page.lifecycleEvent", json!({ "frameId": tab.frame_id, "loaderId": tab.loader_id, "name": "DOMContentLoaded", "timestamp": ts }));
+                page_event(tab, "Page.domContentEventFired", json!({ "timestamp": ts }));
+            }
+            "load" => {
+                tab.load_seen = true;
+                let ts = now();
+                for name in ["load", "networkAlmostIdle", "networkIdle"] {
+                    page_event(tab, "Page.lifecycleEvent", json!({ "frameId": tab.frame_id, "loaderId": tab.loader_id, "name": name, "timestamp": ts }));
+                }
+                page_event(tab, "Page.loadEventFired", json!({ "timestamp": ts }));
+                page_event(tab, "Page.frameStoppedLoading", json!({ "frameId": tab.frame_id }));
+            }
+            "same" => {
+                let url = m.get("url").and_then(Value::as_str).unwrap_or("").to_owned();
+                tab.url = url.clone();
+                let kind = m.get("kind").and_then(Value::as_str).unwrap_or("historyApi");
+                page_event(tab, "Page.navigatedWithinDocument", json!({ "frameId": tab.frame_id, "url": url, "navigationType": kind }));
+            }
+            _ => {}
+        }
+    });
+}
+
+fn now() -> f64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs_f64())
+        .unwrap_or(0.0)
+}
+
+fn new_document(tab: &mut Tab, url: String) {
+    // Commands the old document took die with it.
+    for (_, (id, session)) in tab.js_pending.drain() {
+        let mut message = json!({ "id": id, "error": { "code": -32000, "message": "Execution context was destroyed." } });
+        if let Some(s) = session {
+            message["sessionId"] = Value::String(s);
+        }
+        send(&tab.key, message);
+    }
+    let navigated = tab.pending_loader.is_some();
+    tab.loader_id = tab.pending_loader.take().unwrap_or_else(loader);
+    tab.url = url;
+    tab.dcl_seen = false;
+    tab.load_seen = false;
+    if !navigated {
+        page_event(tab, "Page.frameStartedNavigating", json!({
+            "frameId": tab.frame_id, "url": tab.url, "loaderId": tab.loader_id, "navigationType": "differentDocument",
+        }));
+        page_event(tab, "Page.frameStartedLoading", json!({ "frameId": tab.frame_id }));
+    }
+    page_event(tab, "Runtime.executionContextsCleared", json!({}));
+    page_event(tab, "Page.frameNavigated", json!({ "frame": tab.frame(), "type": "Navigation" }));
+    let mut contexts = vec![(next(), String::new())];
+    for world in &tab.worlds {
+        contexts.push((next(), world.clone()));
+    }
+    tab.contexts = contexts;
+    tab.ready = true;
+    for (cid, name) in tab.contexts.clone() {
+        page_event(tab, "Runtime.executionContextCreated", tab.context(cid, &name));
+    }
+    let ts = now();
+    for name in ["init", "commit"] {
+        page_event(tab, "Page.lifecycleEvent", json!({ "frameId": tab.frame_id, "loaderId": tab.loader_id, "name": name, "timestamp": ts }));
+    }
+    for (jid, method, params) in std::mem::take(&mut tab.queued) {
+        if tab.js_pending.contains_key(&jid) {
+            run_js(tab, jid, &method, &params);
+        }
+    }
+}
diff --git a/crates/gpui/nsh-platform-gpui/src/native/devtools.rs b/crates/gpui/nsh-platform-gpui/src/native/devtools.rs
new file mode 100644
index 000000000..2357cd365
--- /dev/null
+++ b/crates/gpui/nsh-platform-gpui/src/native/devtools.rs
@@ -0,0 +1,76 @@
+//! `webview.devtools.setInspectable` and `webview.devtools.open` (macOS, patch 0025): enabling Safari Web
+//! Inspector attachment on native preview `WKWebView`s, and, where the running WebKit still has it, asking it to
+//! show the inspector window directly.
+//!
+//! Scope, decided the same way `appearance.rs` and `cookie_store.rs` decide theirs: this host's web views have
+//! no stable per-instance id a `host.call` could address (`webview.capture`, patch 0015, addresses one by
+//! on-screen point), so both calls act on every `WKWebView` `web::shown()` reports *right now*. A tab opened
+//! afterwards starts uninspectable again until the next `setInspectable` call (same carried-forward gap
+//! `appearance.rs` documents for colour scheme).
+//!
+//! `setInspectable` sets the PUBLIC `WKWebView.inspectable` property (macOS 13.3+: `-setInspectable:`/
+//! `-isInspectable`, Apple's own replacement for the old `WebKitDeveloperExtras` default). Guarded with
+//! `-respondsToSelector:` so a pre-13.3 host resolves `false` instead of sending an unknown selector. Once set,
+//! AppKit adds "Inspect Element" to the view's native context menu and lets Safari's Develop menu (or any other
+//! `WKWebView`-hosting app's inspector) attach to the page.
+//!
+//! `open` calls `-[WKWebView _showInspector]`, an UNDOCUMENTED, PRIVATE WebKit selector (not in any public
+//! header; this is WebKit's own internal name for what Safari's Develop menu triggers, recovered from WebKit's
+//! source, not from Apple documentation). It is not covered by any API-stability promise Apple makes, can be
+//! renamed or removed by any WebKit update with no notice, and is guarded by the same
+//! `-respondsToSelector:` check so a WebKit that drops it fails soft (a rejection) instead of crashing the host.
+//! This is the "if feasible" private half of the patch: ship it because it works today, document the risk
+//! instead of silently relying on it, and let `open` degrade to a rejection the day it stops responding — the TS
+//! side (`nativePreviewAdjust.ts`) must already treat `webview.devtools.open` as best-effort for this reason.
+
+use objc2::{msg_send, sel};
+
+/// `webview.devtools.setInspectable { enabled }`. Resolves `null`; rejects if no shown `WKWebView` supports the
+/// property (older WebKit) so the TS side can tell "nothing to do" from "it worked".
+pub(super) fn set_inspectable(data: serde_json::Value, call: nsh_engine::HostCall) {
+    let Some(enabled) = data.get("enabled").and_then(|v| v.as_bool()) else {
+        call.reject("webview.devtools.setInspectable needs an enabled boolean");
+        return;
+    };
+    let mut touched = 0usize;
+    for (webview_ptr, _webview, _geometry) in super::web::shown() {
+        // SAFETY: `webview_ptr` is a live `WKWebView` (kept alive by `_webview`, held by `shown()`'s caller until
+        // this loop returns); `respondsToSelector:` and `setInspectable:` are ordinary AppKit/WebKit message
+        // sends with no special calling convention.
+        unsafe {
+            let responds: bool = msg_send![webview_ptr, respondsToSelector: sel!(setInspectable:)];
+            if responds {
+                let _: () = msg_send![webview_ptr, setInspectable: enabled];
+                touched += 1;
+            }
+        }
+    }
+    if touched == 0 {
+        call.reject("webview.devtools.setInspectable: no shown WKWebView supports isInspectable (needs macOS 13.3+)");
+        return;
+    }
+    call.resolve(serde_json::Value::Null);
+}
+
+/// `webview.devtools.open {}`. Private API (see module doc): resolves `null` only if the undocumented
+/// `_showInspector` selector actually fired on at least one shown `WKWebView`, rejects otherwise so the TS side
+/// never reports success for a no-op.
+pub(super) fn open(_data: serde_json::Value, call: nsh_engine::HostCall) {
+    let mut opened = 0usize;
+    for (webview_ptr, _webview, _geometry) in super::web::shown() {
+        // SAFETY: as above. `_showInspector` is undocumented and private (module doc); the selector check keeps
+        // this from sending an unknown selector on a WebKit that has removed or renamed it.
+        unsafe {
+            let responds: bool = msg_send![webview_ptr, respondsToSelector: sel!(_showInspector)];
+            if responds {
+                let _: () = msg_send![webview_ptr, _showInspector];
+                opened += 1;
+            }
+        }
+    }
+    if opened == 0 {
+        call.reject("webview.devtools.open: this WebKit has no private _showInspector selector to call");
+        return;
+    }
+    call.resolve(serde_json::Value::Null);
+}
diff --git a/crates/gpui/nsh-platform-gpui/src/native/record.rs b/crates/gpui/nsh-platform-gpui/src/native/record.rs
new file mode 100644
index 000000000..411c2118a
--- /dev/null
+++ b/crates/gpui/nsh-platform-gpui/src/native/record.rs
@@ -0,0 +1,579 @@
+//! `webview.recordStart` / `webview.recordStop` (macOS): an H.264 MP4 of a shown `WKWebView`'s page. Frames are the
+//! page's own snapshots (`takeSnapshotWithConfiguration:completionHandler:`, as `webview.capture`), taken at the asked
+//! frame rate and appended to an `AVAssetWriter` at their real time, so no screen-recording grant is needed and the
+//! page records under GPUI's surface too. One recording at a time.
+//!
+//! `webview.recordInput` (patch 0017): the page's own recording cursor (previewRecordingPage.ts, injected by the
+//! app) reports pointer and key input while it records; `recordStart`'s `decorations` ({ showKeyPresses,
+//! showMousePresses, primaryColor: {r,g,b,a} 0..1 }) turns this host's own mouse-click ring and key-label badge on,
+//! drawn onto each appended frame (the port of apps/web/src/browser/recordingCompositor.ts, which the web app
+//! composites client-side instead). Timed by the recording's own clock (`started.elapsed()`), the same clock frames
+//! are stamped with, so a decoration never races a frame it should or should not appear on.
+
+use std::{
+    cell::{Cell, RefCell},
+    ffi::{CStr, c_void},
+    ptr,
+    rc::Rc,
+    time::Instant,
+};
+
+use block2::RcBlock;
+use objc2::{
+    class,
+    encode::{Encode, Encoding},
+    msg_send,
+    runtime::{AnyObject, Bool},
+};
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct CGPoint {
+    x: f64,
+    y: f64,
+}
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct CGSize {
+    width: f64,
+    height: f64,
+}
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct CGRect {
+    origin: CGPoint,
+    size: CGSize,
+}
+/// `CMTime`.
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct CMTime {
+    value: i64,
+    timescale: i32,
+    flags: u32,
+    epoch: i64,
+}
+// SAFETY: CoreGraphics' / CoreMedia's layouts on 64-bit Apple targets.
+unsafe impl Encode for CGPoint {
+    const ENCODING: Encoding = Encoding::Struct("CGPoint", &[f64::ENCODING, f64::ENCODING]);
+}
+// SAFETY: as above.
+unsafe impl Encode for CGSize {
+    const ENCODING: Encoding = Encoding::Struct("CGSize", &[f64::ENCODING, f64::ENCODING]);
+}
+// SAFETY: as above.
+unsafe impl Encode for CGRect {
+    const ENCODING: Encoding = Encoding::Struct("CGRect", &[CGPoint::ENCODING, CGSize::ENCODING]);
+}
+// SAFETY: as above (`{?=qiIq}`).
+unsafe impl Encode for CMTime {
+    const ENCODING: Encoding = Encoding::Struct("?", &[i64::ENCODING, i32::ENCODING, u32::ENCODING, i64::ENCODING]);
+}
+
+type CFTypeRef = *const c_void;
+
+#[link(name = "CoreGraphics", kind = "framework")]
+unsafe extern "C" {
+    fn CGImageGetWidth(image: CFTypeRef) -> usize;
+    fn CGImageGetHeight(image: CFTypeRef) -> usize;
+    fn CGColorSpaceCreateDeviceRGB() -> CFTypeRef;
+    fn CGColorSpaceRelease(space: CFTypeRef);
+    fn CGBitmapContextCreate(data: *mut c_void, width: usize, height: usize, bits: usize, row: usize, space: CFTypeRef, info: u32) -> CFTypeRef;
+    fn CGContextDrawImage(cx: CFTypeRef, rect: CGRect, image: CFTypeRef);
+    fn CGContextRelease(cx: CFTypeRef);
+    // The decoration overlay (ring + key badge, patch 0017): plain CoreGraphics shapes, no new crate.
+    fn CGContextSaveGState(cx: CFTypeRef);
+    fn CGContextRestoreGState(cx: CFTypeRef);
+    fn CGContextSetRGBFillColor(cx: CFTypeRef, red: f64, green: f64, blue: f64, alpha: f64);
+    fn CGContextSetRGBStrokeColor(cx: CFTypeRef, red: f64, green: f64, blue: f64, alpha: f64);
+    fn CGContextSetAlpha(cx: CFTypeRef, alpha: f64);
+    fn CGContextSetLineWidth(cx: CFTypeRef, width: f64);
+    fn CGContextFillEllipseInRect(cx: CFTypeRef, rect: CGRect);
+    fn CGContextStrokeEllipseInRect(cx: CFTypeRef, rect: CGRect);
+    fn CGPathCreateWithRoundedRect(rect: CGRect, corner_width: f64, corner_height: f64, transform: *const c_void) -> CFTypeRef;
+    fn CGPathRelease(path: CFTypeRef);
+    fn CGContextAddPath(cx: CFTypeRef, path: CFTypeRef);
+    fn CGContextFillPath(cx: CFTypeRef);
+}
+
+#[link(name = "CoreVideo", kind = "framework")]
+unsafe extern "C" {
+    fn CVPixelBufferCreate(allocator: CFTypeRef, width: usize, height: usize, format: u32, attrs: CFTypeRef, out: *mut CFTypeRef) -> i32;
+    fn CVPixelBufferLockBaseAddress(buffer: CFTypeRef, flags: u64) -> i32;
+    fn CVPixelBufferUnlockBaseAddress(buffer: CFTypeRef, flags: u64) -> i32;
+    fn CVPixelBufferGetBaseAddress(buffer: CFTypeRef) -> *mut c_void;
+    fn CVPixelBufferGetBytesPerRow(buffer: CFTypeRef) -> usize;
+    fn CVPixelBufferRelease(buffer: CFTypeRef);
+}
+
+#[link(name = "AVFoundation", kind = "framework")]
+unsafe extern "C" {
+    static AVMediaTypeVideo: *mut AnyObject;
+    static AVFileTypeMPEG4: *mut AnyObject;
+    static AVVideoCodecKey: *mut AnyObject;
+    static AVVideoCodecTypeH264: *mut AnyObject;
+    static AVVideoWidthKey: *mut AnyObject;
+    static AVVideoHeightKey: *mut AnyObject;
+}
+
+// Already linked (objc2-app-kit, which `capture.rs` / `under.rs` use): the key badge's label (patch 0017).
+#[link(name = "AppKit", kind = "framework")]
+unsafe extern "C" {
+    static NSFontAttributeName: *mut AnyObject;
+    static NSForegroundColorAttributeName: *mut AnyObject;
+}
+
+unsafe extern "C" {
+    static _dispatch_main_q: c_void;
+    fn dispatch_time(when: u64, delta: i64) -> u64;
+    fn dispatch_after_f(when: u64, queue: *const c_void, context: *mut c_void, work: extern "C" fn(*mut c_void));
+}
+
+/// `kCVPixelFormatType_32BGRA`.
+const BGRA: u32 = u32::from_be_bytes(*b"BGRA");
+/// `kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little`.
+const BITMAP_INFO: u32 = 2 | (2 << 12);
+/// `AVAssetWriterStatusWriting`.
+const WRITING: isize = 1;
+
+/// The app's primary colour, 0..1 floats (patch 0017's `recordStart.decorations.primaryColor`; the TS side converts
+/// the app's theme token so this host never parses CSS).
+#[derive(Clone, Copy)]
+struct DecorationColor {
+    r: f64,
+    g: f64,
+    b: f64,
+    a: f64,
+}
+impl Default for DecorationColor {
+    fn default() -> Self {
+        Self { r: 0.145, g: 0.388, b: 0.922, a: 1.0 }
+    }
+}
+
+/// A mouse-press ring, DOM (window) points; `released_at` is the recording's own clock (`started.elapsed()`, ms).
+struct Ring {
+    x: f64,
+    y: f64,
+    width: f64,
+    height: f64,
+    held: bool,
+    released_at: Option<i64>,
+}
+
+/// A key-press badge; `expires_at` is `None` while the key is held.
+struct KeyBadge {
+    label: String,
+    width: f64,
+    expires_at: Option<i64>,
+}
+
+/// `recordingInput`'s state, applied the same way as the web compositor's `RecordingDecorations.apply` /
+/// `.nextRedraw`, kept here instead of in JS since this host draws the overlay itself.
+#[derive(Default)]
+struct Decorations {
+    ring: Option<Ring>,
+    key: Option<KeyBadge>,
+}
+
+struct Recording {
+    path: String,
+    wk: *mut AnyObject,
+    _webview: Rc<wry::WebView>,
+    interval_ns: i64,
+    started: Instant,
+    /// Writer, input, adaptor (retained), made with the first frame's size.
+    writer: Cell<*mut AnyObject>,
+    input: Cell<*mut AnyObject>,
+    adaptor: Cell<*mut AnyObject>,
+    size: Cell<(usize, usize)>,
+    frames: Cell<u64>,
+    last_ms: Cell<i64>,
+    stopping: Cell<bool>,
+    /// A generation, so a tick of an earlier recording stops by itself.
+    id: u64,
+    /// `recordStart`'s `decorations`; `None` when neither option was asked for (the web compositor then runs
+    /// nothing either), so `append` never pays for the overlay when nobody asked to see it.
+    show_key: bool,
+    show_mouse: bool,
+    primary: DecorationColor,
+    decor: RefCell<Decorations>,
+}
+
+thread_local! {
+    static CURRENT: RefCell<Option<Rc<Recording>>> = const { RefCell::new(None) };
+    static NEXT_ID: Cell<u64> = const { Cell::new(1) };
+}
+
+fn num(v: &serde_json::Value, key: &str) -> Option<f64> {
+    v.get(key)?.as_f64()
+}
+
+unsafe fn nsstring(s: &str) -> *mut AnyObject {
+    let bytes = std::ffi::CString::new(s).unwrap_or_default();
+    // SAFETY: a C string for the length of the call.
+    unsafe { msg_send![class!(NSString), stringWithUTF8String: bytes.as_ptr()] }
+}
+
+unsafe fn describe(error: *mut AnyObject, fallback: &str) -> String {
+    if error.is_null() {
+        return fallback.to_string();
+    }
+    // SAFETY: an NSError.
+    unsafe {
+        let text: *mut AnyObject = msg_send![error, localizedDescription];
+        if text.is_null() {
+            return fallback.to_string();
+        }
+        let utf8: *const std::ffi::c_char = msg_send![text, UTF8String];
+        if utf8.is_null() { fallback.to_string() } else { CStr::from_ptr(utf8).to_string_lossy().into_owned() }
+    }
+}
+
+/// Main thread: starts recording the web view `data` names into `data.path`.
+pub(super) fn start(data: serde_json::Value, call: nsh_engine::HostCall) {
+    if CURRENT.with(|c| c.borrow().is_some()) {
+        call.reject("a preview recording is already active");
+        return;
+    }
+    let Some(path) = data.get("path").and_then(|p| p.as_str()).map(str::to_string) else {
+        call.reject("webview.recordStart needs a path");
+        return;
+    };
+    let point = data.get("point").and_then(|p| Some((num(p, "x")? as f32, num(p, "y")? as f32)));
+    let fps = num(&data, "frameRate").unwrap_or(30.0).clamp(1.0, 60.0);
+    let Some((wk, webview, _g)) = super::capture::find(point) else {
+        call.reject("no web view is shown");
+        return;
+    };
+    let _ = std::fs::remove_file(&path);
+    let id = NEXT_ID.with(|n| { let id = n.get(); n.set(id + 1); id });
+    let decorations = data.get("decorations");
+    let show_key = decorations.and_then(|d| d.get("showKeyPresses")).and_then(|v| v.as_bool()).unwrap_or(false);
+    let show_mouse = decorations.and_then(|d| d.get("showMousePresses")).and_then(|v| v.as_bool()).unwrap_or(false);
+    let primary = decorations
+        .and_then(|d| d.get("primaryColor"))
+        .map(|c| DecorationColor {
+            r: num(c, "r").unwrap_or(0.145),
+            g: num(c, "g").unwrap_or(0.388),
+            b: num(c, "b").unwrap_or(0.922),
+            a: num(c, "a").unwrap_or(1.0),
+        })
+        .unwrap_or_default();
+    let rec = Rc::new(Recording {
+        path, wk, _webview: webview, interval_ns: (1_000_000_000.0 / fps) as i64, started: Instant::now(),
+        writer: Cell::new(ptr::null_mut()), input: Cell::new(ptr::null_mut()), adaptor: Cell::new(ptr::null_mut()),
+        size: Cell::new((0, 0)), frames: Cell::new(0), last_ms: Cell::new(-1), stopping: Cell::new(false), id,
+        show_key, show_mouse, primary, decor: RefCell::new(Decorations::default()),
+    });
+    CURRENT.with(|c| *c.borrow_mut() = Some(rec.clone()));
+    tick(id);
+    call.resolve(serde_json::json!({ "path": rec.path, "frameRate": fps }));
+}
+
+/// Main thread: `webview.recordInput` (patch 0017) -- the page's recording cursor reporting a pointer move/press or
+/// a key press/release while the active recording has asked to show it. `data` is the reference's
+/// `DesktopPreviewRecordingInput`: `{ type: "clear" }` | `{ type: "key", label, held, width }` |
+/// `{ type: "pointer", phase, x, y, width, height }`, DOM (window) points. Timed by the recording's own clock, so a
+/// decoration and the frame it should appear on never race different clocks.
+pub(super) fn input(data: serde_json::Value, call: nsh_engine::HostCall) {
+    let Some(rec) = CURRENT.with(|c| c.borrow().clone()) else {
+        call.reject("no preview recording is active");
+        return;
+    };
+    let now = rec.started.elapsed().as_millis() as i64;
+    let kind = data.get("type").and_then(|v| v.as_str()).unwrap_or("");
+    let mut decor = rec.decor.borrow_mut();
+    match kind {
+        "clear" => {
+            decor.ring = None;
+            decor.key = None;
+        }
+        "key" if rec.show_key => {
+            let label = data.get("label").and_then(|v| v.as_str()).map(str::to_string);
+            let held = data.get("held").and_then(|v| v.as_bool()).unwrap_or(false);
+            let width = num(&data, "width").unwrap_or(1280.0);
+            decor.key = label.map(|label| KeyBadge { label, width, expires_at: if held { None } else { Some(now + 900) } });
+        }
+        "pointer" if rec.show_mouse => {
+            let phase = data.get("phase").and_then(|v| v.as_str()).unwrap_or("");
+            let (x, y, width, height) = (num(&data, "x").unwrap_or(0.0), num(&data, "y").unwrap_or(0.0), num(&data, "width").unwrap_or(1280.0), num(&data, "height").unwrap_or(800.0));
+            if phase == "down" || phase == "click" {
+                decor.ring = Some(Ring { x, y, width, height, held: phase == "down", released_at: if phase == "click" { Some(now) } else { None } });
+            } else if decor.ring.as_ref().is_some_and(|r| r.held) {
+                let released_at = if phase == "up" { Some(now) } else { None };
+                if let Some(ring) = decor.ring.as_mut() {
+                    ring.x = x;
+                    ring.y = y;
+                    ring.width = width;
+                    ring.height = height;
+                    ring.held = phase != "up";
+                    ring.released_at = released_at;
+                }
+            }
+        }
+        _ => {}
+    }
+    drop(decor);
+    call.resolve(serde_json::Value::Null);
+}
+
+/// The ring's stroke/fill and the key badge's rounded background, drawn into the frame's `CGContext` (bottom-left
+/// origin, points) before it is appended -- the port of recordingCompositor.ts's `RecordingDecorations.draw`.
+unsafe fn draw_decorations(cx: CFTypeRef, rec: &Recording, width: usize, height: usize, now: i64) {
+    if !rec.show_key && !rec.show_mouse {
+        return;
+    }
+    let decor = rec.decor.borrow();
+    let (w, h) = (width as f64, height as f64);
+    let scale = w / decor.key.as_ref().map(|k| k.width).or_else(|| decor.ring.as_ref().map(|r| r.width)).unwrap_or(1280.0);
+    // SAFETY: `cx` is a live CGBitmapContext for the duration of this call (the caller's).
+    unsafe {
+        if let Some(ring) = &decor.ring {
+            let showing = ring.held || ring.released_at.is_some_and(|at| now < at + 600);
+            if showing {
+                let progress = ring.released_at.map(|at| ((now - at) as f64 / 600.0).clamp(0.0, 1.0)).unwrap_or(0.0);
+                let opacity = 0.9 * (1.0 - progress) * rec.primary.a;
+                let rx = (ring.x * w) / ring.width;
+                let ry_top = (ring.y * h) / ring.height;
+                let ry = h - ry_top; // DOM y (top-down) to CG y (bottom-up).
+                let radius_x = (20.0 * w / ring.width) * (1.0 + progress * 0.5);
+                let radius_y = (20.0 * h / ring.height) * (1.0 + progress * 0.5);
+                let rect = CGRect { origin: CGPoint { x: rx - radius_x, y: ry - radius_y }, size: CGSize { width: radius_x * 2.0, height: radius_y * 2.0 } };
+                CGContextSaveGState(cx);
+                CGContextSetLineWidth(cx, 2.0 * scale);
+                CGContextSetRGBFillColor(cx, rec.primary.r, rec.primary.g, rec.primary.b, opacity * 0.15);
+                CGContextFillEllipseInRect(cx, rect);
+                CGContextSetAlpha(cx, 1.0);
+                CGContextSetRGBStrokeColor(cx, rec.primary.r, rec.primary.g, rec.primary.b, opacity);
+                CGContextStrokeEllipseInRect(cx, rect);
+                CGContextRestoreGState(cx);
+            }
+        }
+        if let Some(key) = &decor.key {
+            if key.expires_at.is_none_or(|at| now < at) {
+                draw_key_badge(cx, key, w, h, scale);
+            }
+        }
+    }
+}
+
+/// The badge background (rgba(32,32,34,.86), 14*scale corner radius) and its white 500-weight label, bottom-centred
+/// 24*scale above the frame's bottom edge, badge height 54*scale -- recordingCompositor.ts's key badge.
+unsafe fn draw_key_badge(cx: CFTypeRef, key: &KeyBadge, width: f64, height: f64, scale: f64) {
+    // SAFETY: an NSAttributedString measured and drawn into `cx` through a temporary NSGraphicsContext, as other
+    // calls in this file use AppKit classes by name (`nsstring`, `describe`) without a Rust binding for them.
+    unsafe {
+        let font: *mut AnyObject = msg_send![class!(NSFont), systemFontOfSize: 26.0 * scale, weight: 0.23f64];
+        let white: *mut AnyObject = msg_send![class!(NSColor), colorWithSRGBRed: 1.0f64, green: 1.0f64, blue: 1.0f64, alpha: 1.0f64];
+        let attrs: *mut AnyObject = msg_send![class!(NSMutableDictionary), dictionaryWithCapacity: 2usize];
+        let _: () = msg_send![attrs, setObject: font, forKey: NSFontAttributeName];
+        let _: () = msg_send![attrs, setObject: white, forKey: NSForegroundColorAttributeName];
+        let text: *mut AnyObject = nsstring(&key.label);
+        let attr_string: *mut AnyObject = msg_send![class!(NSAttributedString), alloc];
+        let attr_string: *mut AnyObject = msg_send![attr_string, initWithString: text, attributes: attrs];
+        let text_size: CGSize = msg_send![attr_string, size];
+        let pad = 36.0 * scale;
+        let badge_width = (text_size.width + pad).min(width - 32.0 * scale).max(0.0);
+        let badge_height = 54.0 * scale;
+        let left = (width - badge_width) / 2.0;
+        let dom_top = height - 24.0 * scale - badge_height; // DOM y (top-down) of the badge's top edge.
+        let bottom = height - (dom_top + badge_height); // CG y (bottom-up) of the badge's bottom edge.
+        let rect = CGRect { origin: CGPoint { x: left, y: bottom }, size: CGSize { width: badge_width, height: badge_height } };
+        CGContextSaveGState(cx);
+        let path = CGPathCreateWithRoundedRect(rect, 14.0 * scale, 14.0 * scale, ptr::null());
+        CGContextSetRGBFillColor(cx, 32.0 / 255.0, 32.0 / 255.0, 34.0 / 255.0, 0.86);
+        CGContextAddPath(cx, path);
+        CGContextFillPath(cx);
+        CGPathRelease(path);
+        let text_left = left + (badge_width - text_size.width) / 2.0;
+        let text_bottom = bottom + (badge_height - text_size.height) / 2.0;
+        let ns_context: *mut AnyObject = msg_send![class!(NSGraphicsContext), graphicsContextWithCGContext: cx, flipped: Bool::NO];
+        let previous: *mut AnyObject = msg_send![class!(NSGraphicsContext), currentContext];
+        let _: () = msg_send![class!(NSGraphicsContext), setCurrentContext: ns_context];
+        let _: () = msg_send![attr_string, drawAtPoint: CGPoint { x: text_left, y: text_bottom }];
+        let _: () = msg_send![class!(NSGraphicsContext), setCurrentContext: previous];
+        CGContextRestoreGState(cx);
+    }
+}
+
+extern "C" fn tick_later(context: *mut c_void) {
+    tick(context as u64);
+}
+
+fn schedule(rec: &Recording) {
+    // SAFETY: libdispatch on the main queue; the context is the recording's id, not a pointer.
+    unsafe {
+        dispatch_after_f(dispatch_time(0, rec.interval_ns), &raw const _dispatch_main_q, rec.id as *mut c_void, tick_later);
+    }
+}
+
+fn tick(id: u64) {
+    let Some(rec) = CURRENT.with(|c| c.borrow().clone()) else { return };
+    if rec.id != id || rec.stopping.get() {
+        return;
+    }
+    let weak = Rc::downgrade(&rec);
+    let block = RcBlock::new(move |image: *mut AnyObject, _error: *mut AnyObject| {
+        let Some(rec) = weak.upgrade() else { return };
+        if rec.stopping.get() {
+            return;
+        }
+        if !image.is_null() {
+            // SAFETY: AppKit / AVFoundation on the main thread, with the handler's image.
+            unsafe { append(&rec, image) };
+        }
+        schedule(&rec);
+    });
+    // SAFETY: the web view is kept alive by the recording.
+    unsafe {
+        let _: () = msg_send![rec.wk, takeSnapshotWithConfiguration: ptr::null_mut::<AnyObject>(), completionHandler: &*block];
+    }
+}
+
+unsafe fn setup(rec: &Recording, width: usize, height: usize) -> bool {
+    // SAFETY: AVFoundation on the main thread; every object kept is retained.
+    unsafe {
+        let url: *mut AnyObject = msg_send![class!(NSURL), fileURLWithPath: nsstring(&rec.path)];
+        let mut error: *mut AnyObject = ptr::null_mut();
+        let writer: *mut AnyObject = msg_send![class!(AVAssetWriter), assetWriterWithURL: url, fileType: AVFileTypeMPEG4, error: &mut error];
+        if writer.is_null() {
+            log::warn!("webview.recordStart: {}", describe(error, "no writer"));
+            return false;
+        }
+        let w: *mut AnyObject = msg_send![class!(NSNumber), numberWithUnsignedLong: width];
+        let h: *mut AnyObject = msg_send![class!(NSNumber), numberWithUnsignedLong: height];
+        let keys = [AVVideoCodecKey, AVVideoWidthKey, AVVideoHeightKey];
+        let values = [AVVideoCodecTypeH264, w, h];
+        let settings: *mut AnyObject = msg_send![class!(NSDictionary), dictionaryWithObjects: values.as_ptr(), forKeys: keys.as_ptr(), count: 3usize];
+        let input: *mut AnyObject = msg_send![class!(AVAssetWriterInput), assetWriterInputWithMediaType: AVMediaTypeVideo, outputSettings: settings];
+        let _: () = msg_send![input, setExpectsMediaDataInRealTime: Bool::YES];
+        let adaptor: *mut AnyObject = msg_send![class!(AVAssetWriterInputPixelBufferAdaptor), assetWriterInputPixelBufferAdaptorWithAssetWriterInput: input, sourcePixelBufferAttributes: ptr::null_mut::<AnyObject>()];
+        let can: Bool = msg_send![writer, canAddInput: input];
+        if !can.as_bool() {
+            return false;
+        }
+        let _: () = msg_send![writer, addInput: input];
+        let started: Bool = msg_send![writer, startWriting];
+        if !started.as_bool() {
+            let err: *mut AnyObject = msg_send![writer, error];
+            log::warn!("webview.recordStart: {}", describe(err, "the writer did not start"));
+            return false;
+        }
+        let zero = CMTime { value: 0, timescale: 1000, flags: 1, epoch: 0 };
+        let _: () = msg_send![writer, startSessionAtSourceTime: zero];
+        for object in [writer, input, adaptor] {
+            let _: *mut AnyObject = msg_send![object, retain];
+        }
+        rec.writer.set(writer);
+        rec.input.set(input);
+        rec.adaptor.set(adaptor);
+        rec.size.set((width, height));
+        true
+    }
+}
+
+unsafe fn append(rec: &Recording, image: *mut AnyObject) {
+    // SAFETY: as the callers say.
+    unsafe {
+        let cg: CFTypeRef = msg_send![image, CGImageForProposedRect: ptr::null_mut::<c_void>(), context: ptr::null_mut::<AnyObject>(), hints: ptr::null_mut::<AnyObject>()];
+        if cg.is_null() {
+            return;
+        }
+        if rec.writer.get().is_null() {
+            // H.264 wants even sizes; later frames are drawn to this size.
+            let width = CGImageGetWidth(cg) & !1;
+            let height = CGImageGetHeight(cg) & !1;
+            if width < 2 || height < 2 || !setup(rec, width, height) {
+                rec.stopping.set(true);
+                return;
+            }
+        }
+        let status: isize = msg_send![rec.writer.get(), status];
+        if status != WRITING {
+            return;
+        }
+        let ready: Bool = msg_send![rec.input.get(), isReadyForMoreMediaData];
+        if !ready.as_bool() {
+            return;
+        }
+        let ms = rec.started.elapsed().as_millis() as i64;
+        if ms <= rec.last_ms.get() {
+            return;
+        }
+        let (width, height) = rec.size.get();
+        let mut buffer: CFTypeRef = ptr::null();
+        if CVPixelBufferCreate(ptr::null(), width, height, BGRA, ptr::null(), &mut buffer) != 0 || buffer.is_null() {
+            return;
+        }
+        CVPixelBufferLockBaseAddress(buffer, 0);
+        let space = CGColorSpaceCreateDeviceRGB();
+        let cx = CGBitmapContextCreate(CVPixelBufferGetBaseAddress(buffer), width, height, 8, CVPixelBufferGetBytesPerRow(buffer), space, BITMAP_INFO);
+        if !cx.is_null() {
+            CGContextDrawImage(cx, CGRect { origin: CGPoint { x: 0.0, y: 0.0 }, size: CGSize { width: width as f64, height: height as f64 } }, cg);
+            draw_decorations(cx, rec, width, height, ms);
+            CGContextRelease(cx);
+        }
+        CGColorSpaceRelease(space);
+        CVPixelBufferUnlockBaseAddress(buffer, 0);
+        let at = CMTime { value: ms, timescale: 1000, flags: 1, epoch: 0 };
+        let ok: Bool = msg_send![rec.adaptor.get(), appendPixelBuffer: buffer, withPresentationTime: at];
+        CVPixelBufferRelease(buffer);
+        if ok.as_bool() {
+            rec.frames.set(rec.frames.get() + 1);
+            rec.last_ms.set(ms);
+        }
+    }
+}
+
+/// Main thread: stops the recording and answers with the file once it is written.
+pub(super) fn stop(call: nsh_engine::HostCall) {
+    let Some(rec) = CURRENT.with(|c| c.borrow_mut().take()) else {
+        call.reject("no preview recording is active");
+        return;
+    };
+    rec.stopping.set(true);
+    let writer = rec.writer.get();
+    if writer.is_null() || rec.frames.get() == 0 {
+        // SAFETY: releasing what was retained.
+        unsafe { release(&rec) };
+        let _ = std::fs::remove_file(&rec.path);
+        call.reject("the preview recorded no frames");
+        return;
+    }
+    let (width, height) = rec.size.get();
+    let frames = rec.frames.get();
+    let duration = rec.last_ms.get();
+    let call = Cell::new(Some(call));
+    let keep = rec.clone();
+    let block = RcBlock::new(move || {
+        let Some(call) = call.take() else { return };
+        // SAFETY: the writer is retained until here.
+        unsafe {
+            let status: isize = msg_send![keep.writer.get(), status];
+            if status != 2 {
+                let err: *mut AnyObject = msg_send![keep.writer.get(), error];
+                call.reject(describe(err, "the recording could not be written"));
+            } else {
+                let size = std::fs::metadata(&keep.path).map(|m| m.len()).unwrap_or(0);
+                call.resolve(serde_json::json!({ "path": keep.path, "mimeType": "video/mp4", "sizeBytes": size, "width": width, "height": height, "frames": frames, "durationMs": duration }));
+            }
+            release(&keep);
+        }
+    });
+    // SAFETY: AVFoundation on the main thread.
+    unsafe {
+        let _: () = msg_send![rec.input.get(), markAsFinished];
+        let _: () = msg_send![writer, finishWritingWithCompletionHandler: &*block];
+    }
+}
+
+unsafe fn release(rec: &Recording) {
+    for cell in [&rec.writer, &rec.input, &rec.adaptor] {
+        let object = cell.replace(ptr::null_mut());
+        if !object.is_null() {
+            // SAFETY: retained in `setup`.
+            unsafe { let _: () = msg_send![object, release]; }
+        }
+    }
+}
