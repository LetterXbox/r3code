+    use super::normalize_pasted_image;
+
+    #[test]
+    fn tiff_and_bmp_clipboard_images_become_png() {
+        let original = image::DynamicImage::new_rgba8(2, 2);
+        for format in [image::ImageFormat::Tiff, image::ImageFormat::Bmp] {
+            let mut source = std::io::Cursor::new(Vec::new());
+            original.write_to(&mut source, format).expect("encode test image");
+            let result = normalize_pasted_image(source.into_inner());
+            assert_eq!(image::guess_format(&result).expect("detect converted image"), image::ImageFormat::Png);
+            assert_eq!(image::load_from_memory(&result).expect("decode converted image").to_rgba8(), original.to_rgba8());
+        }
+    }
+
+    #[test]
+    fn other_and_invalid_data_remain_unchanged() {
+        let data = b"not an image".to_vec();
+        assert_eq!(normalize_pasted_image(data.clone()), data);
+    }
+}
