diff --git a/crates/gpui/nsh-platform-gpui/src/ax.rs b/crates/gpui/nsh-platform-gpui/src/ax.rs
new file mode 100644
index 000000000..c9d18e195
--- /dev/null
+++ b/crates/gpui/nsh-platform-gpui/src/ax.rs
@@ -0,0 +1,276 @@
+//! `ax.trusted` / `ax.windowTree` (macOS, patch 0018): the host's own Accessibility answers for SnapShot.
+//! `ax.trusted` is `AXIsProcessTrusted()` of this process (Electron's `isTrustedAccessibilityClient(false)`).
+//! `ax.windowTree { pid, windowNumber?, title?, maxNodes?, maxDepth?, timeoutMs? }` walks one window of the app
+//! `pid` depth first and resolves `{ windowFrame, truncated, tree }` (screen points, top-left origin), or null
+//! when the host is not trusted or the app has no such window. Runs off the main thread (AX reads are
+//! thread safe), bounded by the node count, the depth and the time budget.
+
+#[cfg(target_os = "macos")]
+mod mac {
+    use std::{
+        ffi::{c_void, CStr},
+        os::raw::c_char,
+        ptr,
+        time::{Duration, Instant},
+    };
+
+    type CFTypeRef = *const c_void;
+    type CFIndex = isize;
+
+    #[repr(C)]
+    #[derive(Clone, Copy, Default)]
+    struct CGPoint { x: f64, y: f64 }
+    #[repr(C)]
+    #[derive(Clone, Copy, Default)]
+    struct CGSize { width: f64, height: f64 }
+
+    const UTF8: u32 = 0x0800_0100;
+    const AX_VALUE_CGPOINT: u32 = 1;
+    const AX_VALUE_CGSIZE: u32 = 2;
+    const NUMBER_SINT64: CFIndex = 4;
+
+    #[link(name = "CoreFoundation", kind = "framework")]
+    unsafe extern "C" {
+        fn CFStringCreateWithBytes(alloc: CFTypeRef, bytes: *const u8, len: CFIndex, encoding: u32, external: u8) -> CFTypeRef;
+        fn CFStringGetLength(s: CFTypeRef) -> CFIndex;
+        fn CFStringGetMaximumSizeForEncoding(len: CFIndex, encoding: u32) -> CFIndex;
+        fn CFStringGetCString(s: CFTypeRef, buffer: *mut c_char, size: CFIndex, encoding: u32) -> u8;
+        fn CFStringGetTypeID() -> usize;
+        fn CFBooleanGetTypeID() -> usize;
+        fn CFBooleanGetValue(b: CFTypeRef) -> u8;
+        fn CFNumberGetTypeID() -> usize;
+        fn CFNumberGetValue(n: CFTypeRef, kind: CFIndex, out: *mut c_void) -> u8;
+        fn CFArrayGetTypeID() -> usize;
+        fn CFArrayGetCount(a: CFTypeRef) -> CFIndex;
+        fn CFArrayGetValueAtIndex(a: CFTypeRef, i: CFIndex) -> CFTypeRef;
+        fn CFGetTypeID(v: CFTypeRef) -> usize;
+        fn CFRelease(v: CFTypeRef);
+    }
+
+    #[link(name = "ApplicationServices", kind = "framework")]
+    unsafe extern "C" {
+        fn AXIsProcessTrusted() -> u8;
+        fn AXUIElementCreateApplication(pid: i32) -> CFTypeRef;
+        fn AXUIElementCopyAttributeValue(el: CFTypeRef, attr: CFTypeRef, out: *mut CFTypeRef) -> i32;
+        fn AXUIElementCopyActionNames(el: CFTypeRef, out: *mut CFTypeRef) -> i32;
+        fn AXUIElementSetMessagingTimeout(el: CFTypeRef, seconds: f32) -> i32;
+        fn AXValueGetTypeID() -> usize;
+        fn AXValueGetValue(value: CFTypeRef, kind: u32, out: *mut c_void) -> u8;
+    }
+
+    pub(super) fn trusted() -> bool {
+        // SAFETY: no arguments; reads this process's TCC state.
+        unsafe { AXIsProcessTrusted() != 0 }
+    }
+
+    /// An owned CF object, released on drop.
+    struct Owned(CFTypeRef);
+    impl Drop for Owned {
+        fn drop(&mut self) {
+            if !self.0.is_null() {
+                // SAFETY: a +1 reference this wrapper owns.
+                unsafe { CFRelease(self.0) }
+            }
+        }
+    }
+
+    fn cfstr(s: &str) -> Owned {
+        // SAFETY: the bytes live for the call; the result is +1.
+        Owned(unsafe { CFStringCreateWithBytes(ptr::null(), s.as_ptr(), s.len() as CFIndex, UTF8, 0) })
+    }
+
+    fn copy(el: CFTypeRef, name: &str) -> Option<Owned> {
+        let key = cfstr(name);
+        let mut out: CFTypeRef = ptr::null();
+        // SAFETY: a valid element and key; the out value is +1 on success.
+        let err = unsafe { AXUIElementCopyAttributeValue(el, key.0, &mut out) };
+        (err == 0 && !out.is_null()).then(|| Owned(out))
+    }
+
+    fn string_of(v: CFTypeRef) -> Option<String> {
+        // SAFETY: type-checked before reading.
+        unsafe {
+            if CFGetTypeID(v) != CFStringGetTypeID() {
+                return None;
+            }
+            let size = CFStringGetMaximumSizeForEncoding(CFStringGetLength(v), UTF8) + 1;
+            let mut buffer = vec![0 as c_char; size.max(1) as usize];
+            if CFStringGetCString(v, buffer.as_mut_ptr(), size, UTF8) == 0 {
+                return None;
+            }
+            let s = CStr::from_ptr(buffer.as_ptr()).to_string_lossy().trim().to_string();
+            (!s.is_empty()).then_some(s)
+        }
+    }
+
+    fn string(el: CFTypeRef, name: &str) -> Option<String> {
+        copy(el, name).and_then(|v| string_of(v.0))
+    }
+
+    fn boolean(el: CFTypeRef, name: &str) -> Option<bool> {
+        let v = copy(el, name)?;
+        // SAFETY: type-checked before reading.
+        unsafe {
+            if CFGetTypeID(v.0) == CFBooleanGetTypeID() {
+                return Some(CFBooleanGetValue(v.0) != 0);
+            }
+            if CFGetTypeID(v.0) == CFNumberGetTypeID() {
+                let mut n: i64 = 0;
+                if CFNumberGetValue(v.0, NUMBER_SINT64, &mut n as *mut i64 as *mut c_void) != 0 {
+                    return Some(n != 0);
+                }
+            }
+        }
+        None
+    }
+
+    fn number(el: CFTypeRef, name: &str) -> Option<i64> {
+        let v = copy(el, name)?;
+        let mut n: i64 = 0;
+        // SAFETY: type-checked before reading.
+        unsafe {
+            (CFGetTypeID(v.0) == CFNumberGetTypeID() && CFNumberGetValue(v.0, NUMBER_SINT64, &mut n as *mut i64 as *mut c_void) != 0).then_some(n)
+        }
+    }
+
+    fn frame(el: CFTypeRef) -> Option<serde_json::Value> {
+        let p = copy(el, "AXPosition")?;
+        let s = copy(el, "AXSize")?;
+        let mut point = CGPoint::default();
+        let mut size = CGSize::default();
+        // SAFETY: AXValues of the asked kinds, checked by type id and by AXValueGetValue's answer.
+        let ok = unsafe {
+            CFGetTypeID(p.0) == AXValueGetTypeID()
+                && CFGetTypeID(s.0) == AXValueGetTypeID()
+                && AXValueGetValue(p.0, AX_VALUE_CGPOINT, &mut point as *mut CGPoint as *mut c_void) != 0
+                && AXValueGetValue(s.0, AX_VALUE_CGSIZE, &mut size as *mut CGSize as *mut c_void) != 0
+        };
+        (ok && [point.x, point.y, size.width, size.height].iter().all(|v| v.is_finite()))
+            .then(|| serde_json::json!({ "x": point.x, "y": point.y, "width": size.width, "height": size.height }))
+    }
+
+    fn actions(el: CFTypeRef) -> Vec<String> {
+        let mut out: CFTypeRef = ptr::null();
+        // SAFETY: the out array is +1 on success.
+        if unsafe { AXUIElementCopyActionNames(el, &mut out) } != 0 || out.is_null() {
+            return Vec::new();
+        }
+        let array = Owned(out);
+        // SAFETY: a CFArray of CFStrings (each checked).
+        unsafe {
+            if CFGetTypeID(array.0) != CFArrayGetTypeID() {
+                return Vec::new();
+            }
+            (0..CFArrayGetCount(array.0).min(32)).filter_map(|i| string_of(CFArrayGetValueAtIndex(array.0, i))).collect()
+        }
+    }
+
+    /// The elements of an array attribute (not retained: valid while `holder` lives).
+    fn elements(holder: &Owned) -> Vec<CFTypeRef> {
+        // SAFETY: checked to be an array; its values stay alive with it.
+        unsafe {
+            if CFGetTypeID(holder.0) != CFArrayGetTypeID() {
+                return Vec::new();
+            }
+            (0..CFArrayGetCount(holder.0)).map(|i| CFArrayGetValueAtIndex(holder.0, i)).collect()
+        }
+    }
+
+    struct Walk {
+        nodes: usize,
+        max_nodes: usize,
+        max_depth: usize,
+        deadline: Instant,
+        truncated: bool,
+    }
+
+    fn node(el: CFTypeRef, depth: usize, walk: &mut Walk) -> Option<serde_json::Value> {
+        if walk.nodes >= walk.max_nodes || depth > walk.max_depth || Instant::now() >= walk.deadline {
+            walk.truncated = true;
+            return None;
+        }
+        walk.nodes += 1;
+        let mut out = serde_json::Map::new();
+        out.insert("role".into(), string(el, "AXRole").into());
+        out.insert("name".into(), string(el, "AXTitle").into());
+        out.insert("value".into(), string(el, "AXValue").into());
+        out.insert("description".into(), string(el, "AXDescription").or_else(|| string(el, "AXHelp")).into());
+        out.insert("bounds".into(), frame(el).unwrap_or(serde_json::Value::Null));
+        if boolean(el, "AXFocused") == Some(true) { out.insert("focused".into(), true.into()); }
+        if boolean(el, "AXEnabled") == Some(false) { out.insert("enabled".into(), false.into()); }
+        if boolean(el, "AXSelected") == Some(true) { out.insert("selected".into(), true.into()); }
+        if let Some(expanded) = boolean(el, "AXExpanded") { out.insert("expanded".into(), expanded.into()); }
+        let names = actions(el);
+        if !names.is_empty() { out.insert("actions".into(), names.into()); }
+        let mut children = Vec::new();
+        if let Some(kids) = copy(el, "AXChildren") {
+            for child in elements(&kids) {
+                match node(child, depth + 1, walk) {
+                    Some(c) => children.push(c),
+                    None => break,
+                }
+            }
+        }
+        out.insert("children".into(), children.into());
+        Some(serde_json::Value::Object(out))
+    }
+
+    pub(super) fn window_tree(data: &serde_json::Value) -> Result<serde_json::Value, String> {
+        if !trusted() {
+            return Ok(serde_json::Value::Null);
+        }
+        let pid = data.get("pid").and_then(|v| v.as_i64()).ok_or("ax.windowTree needs a pid")? as i32;
+        let number = data.get("windowNumber").and_then(|v| v.as_i64());
+        let title = data.get("title").and_then(|v| v.as_str()).map(str::trim).filter(|t| !t.is_empty());
+        let num = |key: &str, default: u64| data.get(key).and_then(|v| v.as_u64()).unwrap_or(default);
+        // SAFETY: the app element is +1 and released by `Owned`.
+        let app = Owned(unsafe { AXUIElementCreateApplication(pid) });
+        if app.0.is_null() {
+            return Ok(serde_json::Value::Null);
+        }
+        // SAFETY: a valid element.
+        unsafe { AXUIElementSetMessagingTimeout(app.0, 0.5) };
+        let Some(windows) = copy(app.0, "AXWindows") else { return Ok(serde_json::Value::Null) };
+        let list = elements(&windows);
+        let window = number
+            .and_then(|n| list.iter().copied().find(|w| self::number(*w, "_AXWindowNumber") == Some(n)))
+            .or_else(|| title.and_then(|t| list.iter().copied().find(|w| string(*w, "AXTitle").as_deref() == Some(t))))
+            .or_else(|| list.first().copied());
+        let Some(window) = window else { return Ok(serde_json::Value::Null) };
+        let mut walk = Walk {
+            nodes: 0,
+            max_nodes: num("maxNodes", 3000).clamp(1, 10_000) as usize,
+            max_depth: num("maxDepth", 24).clamp(1, 64) as usize,
+            deadline: Instant::now() + Duration::from_millis(num("timeoutMs", 2500).clamp(100, 10_000)),
+            truncated: false,
+        };
+        let tree = node(window, 0, &mut walk);
+        Ok(serde_json::json!({
+            "windowFrame": frame(window),
+            "truncated": walk.truncated,
+            "tree": tree,
+        }))
+    }
+}
+
+/// `ax.trusted`.
+pub(crate) fn trusted(call: nsh_engine::HostCall) {
+    #[cfg(target_os = "macos")]
+    call.resolve(serde_json::Value::Bool(mac::trusted()));
+    #[cfg(not(target_os = "macos"))]
+    call.reject("ax.trusted is macOS only");
+}
+
+/// `ax.windowTree`: read on its own thread, answered from there.
+pub(crate) fn window_tree(data: serde_json::Value, call: nsh_engine::HostCall) {
+    #[cfg(target_os = "macos")]
+    std::thread::spawn(move || match mac::window_tree(&data) {
+        Ok(value) => call.resolve(value),
+        Err(message) => call.reject(message),
+    });
+    #[cfg(not(target_os = "macos"))]
+    {
+        let _ = data;
+        call.reject("ax.windowTree is macOS only");
+    }
+}
