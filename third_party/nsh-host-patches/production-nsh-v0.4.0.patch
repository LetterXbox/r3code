+/// Providers accept PNG but not TIFF or BMP, common native clipboard formats.
+pub(crate) fn normalize_pasted_image(bytes: Vec<u8>) -> Vec<u8> {
+    let format = match image::guess_format(&bytes) {
+        Ok(format @ (image::ImageFormat::Tiff | image::ImageFormat::Bmp)) => format,
+        _ => return bytes,
+    };
+    let mut reader = image::ImageReader::new(std::io::Cursor::new(&bytes));
+    reader.set_format(format);
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(16_384);
+    limits.max_image_height = Some(16_384);
+    limits.max_alloc = Some(256 * 1024 * 1024);
+    reader.limits(limits);
+    let Ok(decoded) = reader.decode() else { return bytes };
+    let mut png = std::io::Cursor::new(Vec::new());
+    if decoded.write_to(&mut png, image::ImageFormat::Png).is_err() {
+        return bytes;
+    }
+    png.into_inner()
+}
