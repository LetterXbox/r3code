+    let _ = (surface, window);
+}
+
+/// True when node `id` is a web view shown under the surface (macOS): the
+/// page takes the mouse where nothing of nsh's covers it.
+pub(crate) fn web_under(surface: &Surface, id: NodeId) -> bool {
+    #[cfg(all(target_os = "macos", feature = "webview"))]
+    {
+        matches!(surface.native.hosts.borrow().get(&id), Some(Host::Web(web)) if web.under())
+    }
+    #[cfg(not(all(target_os = "macos", feature = "webview")))]
+    {
+        let _ = (surface, id);
+        false
+    }
+}
