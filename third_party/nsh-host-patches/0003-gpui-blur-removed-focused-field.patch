+/// After a batch: a focused field the batch took out of the tree reports
+/// its blur, so what listens to its focus lets go (a `RichEditor`'s key
+/// bindings: a view still focused keeps them in the surface's table).
+pub(crate) fn batch_applied(surface: &Rc<Surface>) {
+    let Some(field) = FOCUS.with(|f| f.borrow().get(&surface.key()).and_then(|f| f.view.clone()))
+    else {
+        return;
+    };
+    if !field.attached() {
+        move_focus(surface, None, Some(&field));
+    }
+}
