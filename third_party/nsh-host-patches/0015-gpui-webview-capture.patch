diff --git a/crates/gpui/nsh-platform-gpui/src/native/capture.rs b/crates/gpui/nsh-platform-gpui/src/native/capture.rs
new file mode 100644
index 0000000..78d6609
--- /dev/null
+++ b/crates/gpui/nsh-platform-gpui/src/native/capture.rs
@@ -0,0 +1,160 @@
+//! `webview.capture` (macOS): a PNG of a shown `WKWebView`'s page, from
+//! `takeSnapshotWithConfiguration:completionHandler:` (the page itself, so
+//! it works under GPUI's surface and needs no screen-recording grant).
+
+use std::{cell::Cell, ffi::CStr, ptr};
+
+use block2::RcBlock;
+use objc2::{
+    class,
+    encode::{Encode, Encoding},
+    msg_send,
+    runtime::AnyObject,
+};
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct CGPoint {
+    x: f64,
+    y: f64,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct CGSize {
+    width: f64,
+    height: f64,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct CGRect {
+    origin: CGPoint,
+    size: CGSize,
+}
+
+// SAFETY: CoreGraphics' layouts and encodings on 64-bit Apple targets.
+unsafe impl Encode for CGPoint {
+    const ENCODING: Encoding = Encoding::Struct("CGPoint", &[f64::ENCODING, f64::ENCODING]);
+}
+// SAFETY: as above.
+unsafe impl Encode for CGSize {
+    const ENCODING: Encoding = Encoding::Struct("CGSize", &[f64::ENCODING, f64::ENCODING]);
+}
+// SAFETY: as above.
+unsafe impl Encode for CGRect {
+    const ENCODING: Encoding = Encoding::Struct("CGRect", &[CGPoint::ENCODING, CGSize::ENCODING]);
+}
+
+/// `NSBitmapImageFileTypePNG`.
+const PNG: usize = 4;
+
+fn num(v: &serde_json::Value, key: &str) -> Option<f64> {
+    v.get(key)?.as_f64()
+}
+
+/// Main thread: snapshots the web view `data` names and answers `call`.
+pub(super) fn capture(data: serde_json::Value, call: nsh_engine::HostCall) {
+    let point = data
+        .get("point")
+        .and_then(|p| Some((num(p, "x")? as f32, num(p, "y")? as f32)));
+    let rect = data.get("rect").and_then(|r| {
+        Some(CGRect {
+            origin: CGPoint { x: num(r, "x")?, y: num(r, "y")? },
+            size: CGSize { width: num(r, "width")?, height: num(r, "height")? },
+        })
+    });
+    let mut best = None;
+    let mut best_area = -1.0f32;
+    for (wk, webview, g) in super::web::shown() {
+        let v = g.visible;
+        let (x, y) = (f32::from(v.origin.x), f32::from(v.origin.y));
+        let (w, h) = (f32::from(v.size.width), f32::from(v.size.height));
+        if let Some((px, py)) = point
+            && !(px >= x && py >= y && px < x + w && py < y + h)
+        {
+            continue;
+        }
+        if w * h > best_area {
+            best_area = w * h;
+            best = Some((wk, webview, g));
+        }
+    }
+    let Some((wk, webview, g)) = best else {
+        call.reject("no web view is shown");
+        return;
+    };
+    let d = g.document;
+    let frame = serde_json::json!({
+        "x": f32::from(d.origin.x),
+        "y": f32::from(d.origin.y),
+        "width": f32::from(d.size.width),
+        "height": f32::from(d.size.height),
+    });
+    let call = Cell::new(Some(call));
+    let block = RcBlock::new(move |image: *mut AnyObject, error: *mut AnyObject| {
+        // The web view stays alive until the page is taken.
+        let _keep = &webview;
+        let Some(call) = call.take() else { return };
+        // SAFETY: AppKit/Foundation messages on the main thread, on the
+        // objects the completion handler hands over (alive during it).
+        unsafe {
+            if image.is_null() {
+                let mut message = String::from("the page could not be captured");
+                if !error.is_null() {
+                    let text: *mut AnyObject = msg_send![error, localizedDescription];
+                    if !text.is_null() {
+                        let utf8: *const std::ffi::c_char = msg_send![text, UTF8String];
+                        if !utf8.is_null() {
+                            message = CStr::from_ptr(utf8).to_string_lossy().into_owned();
+                        }
+                    }
+                }
+                call.reject(message);
+                return;
+            }
+            let size: CGSize = msg_send![image, size];
+            let tiff: *mut AnyObject = msg_send![image, TIFFRepresentation];
+            let rep: *mut AnyObject = if tiff.is_null() {
+                ptr::null_mut()
+            } else {
+                msg_send![class!(NSBitmapImageRep), imageRepWithData: tiff]
+            };
+            let props: *mut AnyObject = msg_send![class!(NSDictionary), dictionary];
+            let png: *mut AnyObject = if rep.is_null() {
+                ptr::null_mut()
+            } else {
+                msg_send![rep, representationUsingType: PNG, properties: props]
+            };
+            if png.is_null() {
+                call.reject("the page could not be encoded");
+                return;
+            }
+            let b64: *mut AnyObject = msg_send![png, base64EncodedStringWithOptions: 0usize];
+            let utf8: *const std::ffi::c_char = msg_send![b64, UTF8String];
+            let encoded = CStr::from_ptr(utf8).to_string_lossy();
+            call.resolve(serde_json::json!({
+                "dataUrl": format!("data:image/png;base64,{encoded}"),
+                "width": size.width,
+                "height": size.height,
+                "frame": frame.clone(),
+            }));
+        }
+    });
+    // SAFETY: as above; the configuration is released after the call (the
+    // web view copies it).
+    unsafe {
+        let config: *mut AnyObject = match rect {
+            Some(r) => {
+                let c: *mut AnyObject = msg_send![class!(WKSnapshotConfiguration), new];
+                let _: () = msg_send![c, setRect: r];
+                c
+            }
+            None => ptr::null_mut(),
+        };
+        let _: () = msg_send![wk, takeSnapshotWithConfiguration: config, completionHandler: &*block];
+        if !config.is_null() {
+            let _: () = msg_send![config, release];
+        }
+    }
+}
