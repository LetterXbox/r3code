+/// `focus()` / `blur()` of a web view: carried out by the web view (the
+/// window's first responder) and true; false for any other view.
+pub(crate) fn web_focus(surface: &Rc<Surface>, view: &NshView, command: &Command) -> bool {
+    let host = surface
+        .native
+        .hosts
+        .borrow()
+        .get(&view.id())
+        .map(Host::item_ref);
+    match host {
+        Some(HostRef::Web(web)) => {
+            if matches!(command, Command::Focus) {
+                // The app's field lets go, and no request of the surface
+                // takes the keyboard back on the next frame.
+                crate::text_input::blur_all(surface);
+                surface.window_focus_requested.set(false);
+            }
+            web.command(command);
+            true
+        }
+        _ => false,
     }
 }
 
