+        /// Gives the web view the keyboard. wry's `focus` needs the view
+        /// in a window (it unwraps it).
+        fn focus(webview: &wry::WebView) -> wry::Result<()> {
+            #[cfg(target_os = "macos")]
+            {
+                use wry::WebViewExtMacOS;
+                if webview.webview().window().is_none() {
+                    return Ok(());
+                }
+            }
+            webview.focus()
+        }
