+/// True when this host shows web views under the surface (macOS, unless
+/// `NSH_WEBVIEW_ABOVE` asks for the old placement): what nsh paints after a
+/// web view covers the page, so an app need not hide the page under its
+/// menus and dialogs. The app asks with `host.call("webview.underSurface")`.
+pub(crate) fn web_under_surface() -> bool {
+    #[cfg(all(target_os = "macos", feature = "webview"))]
+    {
+        under::enabled()
+    }
+    #[cfg(not(all(target_os = "macos", feature = "webview")))]
+    {
+        false
+    }
+}
