+/// macOS: registers a `BlockMouse` hitbox, in GPUI's window overlay
+/// surface, over every root child after `surface.overlay_split` (set by
+/// `native::prepaint`, just before this runs, to the last root child a
+/// currently shown web view descends from; `nsh_core`'s `position:
+/// fixed` promotion inserts menus, dialogs and toasts as later children
+/// of the surface's root, "opened last, on top": `core/overlay.rs`
+/// `sync_overlays`). With no web view shown, `overlay_split` is `None`
+/// and this does nothing, so an ordinary window renders exactly as
+/// before this patch. Without the hitbox, a routed child's area has
+/// none of its own in that surface, so `GPUIOverlayView`'s `hitTest:`
+/// (`fast/composition.rs` `overlay_hit_test`) finds nothing there and a
+/// click meant for the popup falls through to the web view's
+/// composition surface behind it (`native::web`'s `mod macos`).
+#[cfg(target_os = "macos")]
+fn overlay_hitboxes(surface: &Surface, surface_bounds: Bounds<Pixels>, window: &mut Window) {
+    let Some(split) = surface.overlay_split.get() else {
+        surface.overlay_input_hitboxes.borrow_mut().clear();
+        return;
+    };
+    let children = surface.root.child_views();
+    if children.len() <= split + 1 {
+        surface.overlay_input_hitboxes.borrow_mut().clear();
+        return;
+    }
+    let overlay_id = match window.enable_window_composition() {
+        Ok(composition) => composition.overlay_surface(),
+        Err(err) => {
+            log::warn!("web view: cannot reach the window's overlay surface: {err:#}");
+            surface.overlay_input_hitboxes.borrow_mut().clear();
+            return;
+        }
+    };
+    let rects: Vec<Bounds<Pixels>> = {
+        let root_state = surface.root.state();
+        children[split + 1..]
+            .iter()
+            .filter_map(|child| {
+                let s = child.try_state()?;
+                if s.style.hidden
+                    || s.concealed
+                    || s.opacity() <= 0.0
+                    || s.props.pointer_events == nsh_core::PointerEvents::None
+                {
+                    // `pointer_events: "none"`: the whole subtree is
+                    // transparent to touches (a full-window toast or
+                    // tooltip wrapper, typically), so no hitbox here keeps
+                    // the page clickable under it. It is still drawn by
+                    // `draw_overlay_children`.
+                    return None;
+                }
+                let (ox, oy) = root_state.child_origin(s.frame, s.shift);
+                Some(bounds(
+                    f32::from(surface_bounds.origin.x) + ox,
+                    f32::from(surface_bounds.origin.y) + oy,
+                    s.frame.size.width.0,
+                    s.frame.size.height.0,
+                ))
+            })
+            .collect()
