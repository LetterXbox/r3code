+    #[cfg(target_os = "macos")]
+    mod macos {
+        //! The web view below GPUI's own content: a native composition
+        //! surface (`gpui::Window::enable_window_composition`), the same
+        //! mechanism GPUI itself uses to mix native and GPUI-drawn
+        //! surfaces in one window.
+        //!
+        //! `create_native_surface()` makes a surface GPUI keeps *below*
+        //! its window-level overlay surface
+        //! (`WindowComposition::overlay_surface`) for the life of the
+        //! window (`register_platform_surface` in gpui-fast-macos always
+        //! places a new native surface under it), so anything GPUI paints
+        //! into that overlay surface (`Window::with_composition_surface`)
+        //! stays visible over the page. `render.rs`'s `overlay_hitboxes`
+        //! and `draw_overlay_children` route nsh's own popups (menus,
+        //! dialogs, toasts) into that same surface; see
+        //! `third_party/nsh-host/README.md` for what that heuristic does
+        //! and does not cover, and for the `T3GPUI_WEBVIEW_UNDER_SURFACE`
+        //! flag the app still gates on.
+        //!
+        //! AppKit hit-testing needs no patch here: the container this
+        //! creates is a plain, un-overridden `NSView`, so where no GPUI
+        //! overlay view covers a point, AppKit's own `hitTest:` falls
+        //! through to it (gpui-fast-macos's `GPUIOverlayView` already
+        //! returns `nil` outside its own hitboxes;
+        //! `fast/composition.rs` `overlay_hit_test`).
+
+        use std::{
+            ffi::c_void,
+            ptr::NonNull,
+            rc::Rc,
+            time::Duration,
+        };
+
+        use gpui::{App, Bounds, DevicePixels, Pixels, Window, WindowCompositionSurface, point, size};
+        use raw_window_handle::{
+            AppKitWindowHandle, HandleError, HasWindowHandle, RawWindowHandle, WindowHandle,
+        };
+
+        use crate::native::Geometry;
+
+        /// How long a web view's composition surface outlives the web
+        /// view (`release`; mirrors the Linux module's `RELEASE_DELAY`,
+        /// though AppKit needs no wait before removing it -- this just
+        /// keeps the two platforms' teardown shaped alike).
+        const RELEASE_DELAY: Duration = Duration::from_millis(50);
+
+        /// A web view's composition surface: a plain `NSView`, clipped to
+        /// its bounds, that GPUI keeps below its overlay surface.
+        pub(super) struct NativeSurface {
+            surface: WindowCompositionSurface,
+            window: gpui::AnyWindowHandle,
+            cx: gpui::AsyncApp,
+        }
+
+        /// Builds `builder`'s web view as a child of a new native
+        /// composition surface, below GPUI's own content.
+        pub(super) fn build(
+            builder: wry::WebViewBuilder<'_>,
+            window: &mut Window,
+            cx: &App,
+        ) -> Result<(wry::WebView, NativeSurface), (String, &'static str)> {
+            let unavailable = "WebView is not available";
+            let composition = window
+                .enable_window_composition()
+                .map_err(|e| (e.to_string(), unavailable))?;
+            let surface = composition
+                .create_native_surface()
+                .map_err(|e| (e.to_string(), unavailable))?;
+            let parent = container_handle(&surface).map_err(|e| (e, unavailable))?;
+            let webview = builder
+                .build_as_child(&parent)
+                .map_err(|e| (e.to_string(), "WebView could not be made"))?;
+            let native = NativeSurface {
+                surface,
+                window: Window::window_handle(window),
+                cx: cx.to_async(),
+            };
+            Ok((webview, native))
+        }
+
+        /// The composition surface's container view, as the `NSView` wry
+        /// needs to build the web view as its child.
+        fn container_handle(surface: &WindowCompositionSurface) -> Result<MacParent, String> {
+            let attachment = surface.platform_surface().map_err(|e| e.to_string())?;
+            let handle = attachment.platform_handle().map_err(|e| e.to_string())?;
+            let view = handle
+                .downcast::<usize>()
+                .map_err(|_| "native surface is not backed by an AppKit view".to_owned())?;
+            let ptr = NonNull::new(*view as *mut c_void)
+                .ok_or_else(|| "native surface view is null".to_owned())?;
+            Ok(MacParent(AppKitWindowHandle::new(ptr)))
+        }
+
+        /// A raw `NSView` handle wry can build a web view as a child of.
+        struct MacParent(AppKitWindowHandle);
+
+        impl HasWindowHandle for MacParent {
+            fn window_handle(&self) -> Result<WindowHandle<'_>, HandleError> {
+                // SAFETY: the composition surface (and its container view)
+                // outlives the web view: `Built` holds both, and drops the
+                // web view first (field order; `wry::WebView`'s own `Drop`
+                // detaches it from its superview before the container
+                // goes).
+                Ok(unsafe { WindowHandle::borrow_raw(RawWindowHandle::AppKit(self.0)) })
+            }
+        }
+
+        impl NativeSurface {
+            /// Shows `webview` at `g`: the container at its visible
+            /// rectangle, the page at its document rectangle relative to
+            /// the container.
+            pub(super) fn place(
+                &self,
+                webview: &wry::WebView,
+                g: Geometry,
+                scale: f32,
+            ) -> anyhow::Result<()> {
+                let device = |v: Pixels| DevicePixels((f32::from(v) * scale).round() as i32);
+                let v = g.visible;
+                let bounds = Bounds::new(
+                    point(device(v.origin.x), device(v.origin.y)),
+                    size(device(v.size.width), device(v.size.height)),
+                );
+                let attachment = self.surface.platform_surface()?;
+                attachment.set_bounds(bounds)?;
+                attachment.set_visible(true)?;
+                let d = g.document;
+                webview.set_bounds(wry::Rect {
+                    position: wry::dpi::LogicalPosition::new(
+                        f64::from(f32::from(d.origin.x) - f32::from(v.origin.x)),
+                        f64::from(f32::from(d.origin.y) - f32::from(v.origin.y)),
+                    )
+                    .into(),
+                    size: wry::dpi::LogicalSize::new(
+                        f64::from(f32::from(d.size.width)),
+                        f64::from(f32::from(d.size.height)),
+                    )
+                    .into(),
+                })?;
+                Ok(())
+            }
+
+            pub(super) fn set_visible(&self, visible: bool) -> anyhow::Result<()> {
+                self.surface.platform_surface()?.set_visible(visible)
+            }
+
+            /// Removes the surface from GPUI's composition tree, after the
+            /// web view itself went (mirrors the Linux module's
+            /// `release`): `Drop` only has `&mut self`, not the `&mut
+            /// Window` `WindowComposition::remove_surface` needs, so this
+            /// is done from a spawned update instead of `Built`'s `Drop`
+            /// directly.
+            pub(super) fn release(self, webview: Rc<wry::WebView>) {
+                self.cx
+                    .clone()
+                    .spawn(async move |cx| {
+                        drop(webview);
+                        cx.background_executor().timer(RELEASE_DELAY).await;
+                        let removed = self.window.update(cx, |_, window, _| {
+                            window
+                                .enable_window_composition()?
+                                .remove_surface(self.surface.id())
+                        });
+                        if let Ok(Err(err)) = removed {
+                            log::warn!("web view: cannot remove its composition surface: {err:#}");
+                        }
+                    })
+                    .detach();
+            }
+        }
+    }
 }
 
