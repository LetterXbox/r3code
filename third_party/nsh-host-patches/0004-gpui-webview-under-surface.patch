+/// macOS: the index, among `surface.root`'s children, of the one `view`
+/// descends from, `None` when `view` is not under `surface.root` (a
+/// screen or modal's own root hosts it instead -- such a web view's
+/// panel is not routed against: see `third_party/nsh-host/README.md`).
+#[cfg(target_os = "macos")]
+fn root_child_index(surface: &Surface, view: &NshView) -> Option<usize> {
+    let mut node = view.clone();
+    loop {
+        let parent = node.parent_view()?;
+        if parent == surface.root {
+            return surface.root.child_views().iter().position(|c| *c == node);
+        }
+        node = parent;
+    }
 }
 
