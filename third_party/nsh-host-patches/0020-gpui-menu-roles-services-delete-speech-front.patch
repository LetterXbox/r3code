+    /// The focused field's selected text (`None`: no field, or a
+    /// password; empty: a caret).
+    pub(crate) fn selection_text(surface: &Surface) -> Option<String> {
+        let (_, input) = field(surface)?;
+        if input.secure() {
+            return None;
+        }
+        let model = input.model.borrow();
+        let text = model.text();
+        let (s, e) = model.selection();
+        let (s, e) = (s.min(e), s.max(e));
+        Some(text.get(s..e).unwrap_or_default().to_owned())
+    }
+
+    /// What `startSpeaking` speaks: the selection, else all of the
+    /// field's text (NSTextView's rule).
+    pub(crate) fn speech_text(surface: &Surface) -> Option<String> {
+        let selected = selection_text(surface)?;
+        if !selected.is_empty() {
+            return Some(selected);
+        }
+        let (_, input) = field(surface)?;
+        let model = input.model.borrow();
+        Some(model.text().to_owned())
+    }
