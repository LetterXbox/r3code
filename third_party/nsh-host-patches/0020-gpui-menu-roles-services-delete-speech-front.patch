+/// `delete`: Backspace into the focused field, which removes its
+/// selection.
+fn delete_selection(surface: &Rc<Surface>) {
+    if crate::text_input::ime::selection_text(surface).is_none_or(|t| t.is_empty()) {
+        return;
+    }
+    crate::input::key(
+        surface,
+        KeyEvent {
+            vk: 0x08,
+            down: true,
+            repeat: false,
+            modifiers: Modifiers::default(),
+        },
+    );
+}
+
+/// Speech (`startSpeaking`, `stopSpeaking`) and Bring All to Front: AppKit
+/// calls, macOS only (patch 0014).
+mod speech {
+    use std::rc::Rc;
+
+    use crate::surface::Surface;
+
+    #[cfg(target_os = "macos")]
+    thread_local! {
+        static SYNTH: std::cell::Cell<*mut objc2::runtime::AnyObject> =
+            const { std::cell::Cell::new(std::ptr::null_mut()) };
+    }
+
+    /// Speaks the focused field's selection, or all of its text, as
+    /// NSTextView's `startSpeaking:` does.
+    pub(super) fn start(surface: &Rc<Surface>) {
+        #[cfg(target_os = "macos")]
+        {
+            use objc2::{class, msg_send, runtime::AnyObject};
+            use objc2_foundation::NSString;
+            let Some(text) = crate::text_input::ime::speech_text(surface) else {
+                return;
+            };
+            if text.trim().is_empty() {
+                return;
+            }
+            stop();
+            let synth = SYNTH.with(|s| {
+                if s.get().is_null() {
+                    // SAFETY: a new NSSpeechSynthesizer with the default
+                    // voice, kept (retained) for the app's life.
+                    let made: *mut AnyObject = unsafe {
+                        let alloc: *mut AnyObject = msg_send![class!(NSSpeechSynthesizer), alloc];
+                        msg_send![alloc, initWithVoice: std::ptr::null_mut::<AnyObject>()]
+                    };
+                    s.set(made);
+                }
+                s.get()
+            });
+            if synth.is_null() {
+                return;
+            }
+            let text = NSString::from_str(&text);
+            // SAFETY: a live synthesizer and string.
+            let _: objc2::runtime::Bool = unsafe { msg_send![synth, startSpeakingString: &*text] };
+        }
+        #[cfg(not(target_os = "macos"))]
+        let _ = surface;
+    }
+
+    pub(super) fn stop() {
+        #[cfg(target_os = "macos")]
+        SYNTH.with(|s| {
+            let synth = s.get();
+            if !synth.is_null() {
+                // SAFETY: the live synthesizer `start` made.
+                let _: () = unsafe { objc2::msg_send![synth, stopSpeaking] };
+            }
+        });
+    }
+
+    /// NSApplication's `arrangeInFront:`.
+    pub(super) fn arrange_in_front() {
+        #[cfg(target_os = "macos")]
+        {
+            use objc2::{class, msg_send, runtime::AnyObject};
+            // SAFETY: the shared application, on the main thread.
+            unsafe {
+                let app: *mut AnyObject = msg_send![class!(NSApplication), sharedApplication];
+                if !app.is_null() {
+                    let _: () = msg_send![app, arrangeInFront: std::ptr::null_mut::<AnyObject>()];
+                }
+            }
+        }
+    }
+}
