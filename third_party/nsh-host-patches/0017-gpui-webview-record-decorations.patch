+/// Main thread: `webview.recordInput` (patch 0017) -- the page's recording cursor reporting a pointer move/press or
+/// a key press/release while the active recording has asked to show it. `data` is the reference's
+/// `DesktopPreviewRecordingInput`: `{ type: "clear" }` | `{ type: "key", label, held, width }` |
+/// `{ type: "pointer", phase, x, y, width, height }`, DOM (window) points. Timed by the recording's own clock, so a
+/// decoration and the frame it should appear on never race different clocks.
+pub(super) fn input(data: serde_json::Value, call: nsh_engine::HostCall) {
+    let Some(rec) = CURRENT.with(|c| c.borrow().clone()) else {
+        call.reject("no preview recording is active");
+        return;
+    };
+    let now = rec.started.elapsed().as_millis() as i64;
+    let kind = data.get("type").and_then(|v| v.as_str()).unwrap_or("");
+    let mut decor = rec.decor.borrow_mut();
+    match kind {
+        "clear" => {
+            decor.ring = None;
+            decor.key = None;
+        }
+        "key" if rec.show_key => {
+            let label = data.get("label").and_then(|v| v.as_str()).map(str::to_string);
+            let held = data.get("held").and_then(|v| v.as_bool()).unwrap_or(false);
+            let width = num(&data, "width").unwrap_or(1280.0);
+            decor.key = label.map(|label| KeyBadge { label, width, expires_at: if held { None } else { Some(now + 900) } });
+        }
+        "pointer" if rec.show_mouse => {
+            let phase = data.get("phase").and_then(|v| v.as_str()).unwrap_or("");
+            let (x, y, width, height) = (num(&data, "x").unwrap_or(0.0), num(&data, "y").unwrap_or(0.0), num(&data, "width").unwrap_or(1280.0), num(&data, "height").unwrap_or(800.0));
+            if phase == "down" || phase == "click" {
+                decor.ring = Some(Ring { x, y, width, height, held: phase == "down", released_at: if phase == "click" { Some(now) } else { None } });
+            } else if decor.ring.as_ref().is_some_and(|r| r.held) {
+                let released_at = if phase == "up" { Some(now) } else { None };
+                if let Some(ring) = decor.ring.as_mut() {
+                    ring.x = x;
+                    ring.y = y;
+                    ring.width = width;
+                    ring.height = height;
+                    ring.held = phase != "up";
+                    ring.released_at = released_at;
+                }
+            }
+        }
+        _ => {}
+    }
+    drop(decor);
+    call.resolve(serde_json::Value::Null);
+}
+
+/// The ring's stroke/fill and the key badge's rounded background, drawn into the frame's `CGContext` (bottom-left
+/// origin, points) before it is appended -- the port of recordingCompositor.ts's `RecordingDecorations.draw`.
+unsafe fn draw_decorations(cx: CFTypeRef, rec: &Recording, width: usize, height: usize, now: i64) {
+    if !rec.show_key && !rec.show_mouse {
+        return;
+    }
+    let decor = rec.decor.borrow();
+    let (w, h) = (width as f64, height as f64);
+    let scale = w / decor.key.as_ref().map(|k| k.width).or_else(|| decor.ring.as_ref().map(|r| r.width)).unwrap_or(1280.0);
+    // SAFETY: `cx` is a live CGBitmapContext for the duration of this call (the caller's).
+    unsafe {
+        if let Some(ring) = &decor.ring {
+            let showing = ring.held || ring.released_at.is_some_and(|at| now < at + 600);
+            if showing {
+                let progress = ring.released_at.map(|at| ((now - at) as f64 / 600.0).clamp(0.0, 1.0)).unwrap_or(0.0);
+                let opacity = 0.9 * (1.0 - progress) * rec.primary.a;
+                let rx = (ring.x * w) / ring.width;
+                let ry_top = (ring.y * h) / ring.height;
+                let ry = h - ry_top; // DOM y (top-down) to CG y (bottom-up).
+                let radius_x = (20.0 * w / ring.width) * (1.0 + progress * 0.5);
+                let radius_y = (20.0 * h / ring.height) * (1.0 + progress * 0.5);
+                let rect = CGRect { origin: CGPoint { x: rx - radius_x, y: ry - radius_y }, size: CGSize { width: radius_x * 2.0, height: radius_y * 2.0 } };
+                CGContextSaveGState(cx);
+                CGContextSetLineWidth(cx, 2.0 * scale);
+                CGContextSetRGBFillColor(cx, rec.primary.r, rec.primary.g, rec.primary.b, opacity * 0.15);
+                CGContextFillEllipseInRect(cx, rect);
+                CGContextSetAlpha(cx, 1.0);
+                CGContextSetRGBStrokeColor(cx, rec.primary.r, rec.primary.g, rec.primary.b, opacity);
+                CGContextStrokeEllipseInRect(cx, rect);
+                CGContextRestoreGState(cx);
+            }
+        }
+        if let Some(key) = &decor.key {
+            if key.expires_at.is_none_or(|at| now < at) {
+                draw_key_badge(cx, key, w, h, scale);
+            }
+        }
+    }
+}
+
+/// The badge background (rgba(32,32,34,.86), 14*scale corner radius) and its white 500-weight label, bottom-centred
+/// 24*scale above the frame's bottom edge, badge height 54*scale -- recordingCompositor.ts's key badge.
+unsafe fn draw_key_badge(cx: CFTypeRef, key: &KeyBadge, width: f64, height: f64, scale: f64) {
+    // SAFETY: an NSAttributedString measured and drawn into `cx` through a temporary NSGraphicsContext, as other
+    // calls in this file use AppKit classes by name (`nsstring`, `describe`) without a Rust binding for them.
+    unsafe {
+        let font: *mut AnyObject = msg_send![class!(NSFont), systemFontOfSize: 26.0 * scale, weight: 0.23f64];
+        let white: *mut AnyObject = msg_send![class!(NSColor), colorWithSRGBRed: 1.0f64, green: 1.0f64, blue: 1.0f64, alpha: 1.0f64];
+        let attrs: *mut AnyObject = msg_send![class!(NSMutableDictionary), dictionaryWithCapacity: 2usize];
+        let _: () = msg_send![attrs, setObject: font, forKey: NSFontAttributeName];
+        let _: () = msg_send![attrs, setObject: white, forKey: NSForegroundColorAttributeName];
+        let text: *mut AnyObject = nsstring(&key.label);
+        let attr_string: *mut AnyObject = msg_send![class!(NSAttributedString), alloc];
+        let attr_string: *mut AnyObject = msg_send![attr_string, initWithString: text, attributes: attrs];
+        let text_size: CGSize = msg_send![attr_string, size];
+        let pad = 36.0 * scale;
+        let badge_width = (text_size.width + pad).min(width - 32.0 * scale).max(0.0);
+        let badge_height = 54.0 * scale;
+        let left = (width - badge_width) / 2.0;
+        let dom_top = height - 24.0 * scale - badge_height; // DOM y (top-down) of the badge's top edge.
+        let bottom = height - (dom_top + badge_height); // CG y (bottom-up) of the badge's bottom edge.
+        let rect = CGRect { origin: CGPoint { x: left, y: bottom }, size: CGSize { width: badge_width, height: badge_height } };
+        CGContextSaveGState(cx);
+        let path = CGPathCreateWithRoundedRect(rect, 14.0 * scale, 14.0 * scale, ptr::null());
+        CGContextSetRGBFillColor(cx, 32.0 / 255.0, 32.0 / 255.0, 34.0 / 255.0, 0.86);
+        CGContextAddPath(cx, path);
+        CGContextFillPath(cx);
+        CGPathRelease(path);
+        let text_left = left + (badge_width - text_size.width) / 2.0;
+        let text_bottom = bottom + (badge_height - text_size.height) / 2.0;
+        let ns_context: *mut AnyObject = msg_send![class!(NSGraphicsContext), graphicsContextWithCGContext: cx, flipped: Bool::NO];
+        let previous: *mut AnyObject = msg_send![class!(NSGraphicsContext), currentContext];
+        let _: () = msg_send![class!(NSGraphicsContext), setCurrentContext: ns_context];
+        let _: () = msg_send![attr_string, drawAtPoint: CGPoint { x: text_left, y: text_bottom }];
+        let _: () = msg_send![class!(NSGraphicsContext), setCurrentContext: previous];
+        CGContextRestoreGState(cx);
+    }
+}
