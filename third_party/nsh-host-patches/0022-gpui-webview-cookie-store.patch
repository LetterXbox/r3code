diff --git a/crates/gpui/nsh-platform-gpui/src/native/cookie_store.rs b/crates/gpui/nsh-platform-gpui/src/native/cookie_store.rs
new file mode 100644
index 0000000..75076dc
--- /dev/null
+++ b/crates/gpui/nsh-platform-gpui/src/native/cookie_store.rs
@@ -0,0 +1,247 @@
+//! `webview.cookies.set` / `webview.cookies.clear` / `webview.cache.clear` (macOS, patch 0022): read/write the
+//! cookie store `WKWebView` uses, via `WKWebsiteDataStore.defaultDataStore().httpCookieStore()`.
+//!
+//! Scope, decided here rather than guessed: this host's web views (`web.rs`) are all built with the default
+//! `WKWebViewConfiguration`, so every one already shares `WKWebsiteDataStore.defaultDataStore()` (no
+//! `WKWebsiteDataStore(forIdentifier:)` partitioning exists anywhere in this tree, grepped). The TS side's
+//! `partition` field (`browserCookieImport.ts`'s `resolveWritePartition`, `nativePreviewAdjust.ts`) is accepted and
+//! ignored: every call below acts on the one store every tab already uses. Giving each partition its own
+//! `WKWebsiteDataStore` is a separate, larger change (a `websiteDataStore` per `WebViewHostProps`, plumbed through
+//! `nsh-core`'s host props) that this patch does not attempt.
+//!
+//! `httpOnly` on an imported cookie cannot be set here: `NSHTTPCookie`'s public `cookieWithProperties:` dictionary
+//! has no documented key for it (`isHTTPOnly` is a read-only property WebKit derives from a `Set-Cookie` response
+//! header, not from a dictionary apps build); a cookie written by `webview.cookies.set` is never `HttpOnly`, so a
+//! page's own script can read it back. Documented, not silently dropped.
+
+use std::cell::Cell;
+use std::ffi::CString;
+
+use block2::RcBlock;
+use objc2::{class, msg_send, runtime::AnyObject};
+
+// NSHTTPCookie property keys and the WKWebsiteDataStore record type names: real framework-exported `NSString *
+// const` symbols (Foundation, WebKit), read directly rather than guessed as Rust string literals.
+#[link(name = "Foundation", kind = "framework")]
+unsafe extern "C" {
+    static NSHTTPCookieName: *const AnyObject;
+    static NSHTTPCookieValue: *const AnyObject;
+    static NSHTTPCookieDomain: *const AnyObject;
+    static NSHTTPCookiePath: *const AnyObject;
+    static NSHTTPCookieSecure: *const AnyObject;
+    static NSHTTPCookieExpires: *const AnyObject;
+    static NSHTTPCookieSameSitePolicy: *const AnyObject;
+}
+#[link(name = "WebKit", kind = "framework")]
+unsafe extern "C" {
+    static WKWebsiteDataTypeCookies: *const AnyObject;
+    static WKWebsiteDataTypeDiskCache: *const AnyObject;
+    static WKWebsiteDataTypeMemoryCache: *const AnyObject;
+    static WKWebsiteDataTypeOfflineWebApplicationCache: *const AnyObject;
+    static WKWebsiteDataTypeLocalStorage: *const AnyObject;
+    static WKWebsiteDataTypeSessionStorage: *const AnyObject;
+    static WKWebsiteDataTypeIndexedDBDatabases: *const AnyObject;
+    static WKWebsiteDataTypeServiceWorkerRegistrations: *const AnyObject;
+}
+
+fn ns_string(s: &str) -> *mut AnyObject {
+    // SAFETY: `s` has no interior NUL (checked by `CString::new`); the class and selector are Foundation's.
+    unsafe {
+        let c = CString::new(s).unwrap_or_default();
+        msg_send![class!(NSString), stringWithUTF8String: c.as_ptr()]
+    }
+}
+
+/// `WKWebsiteDataStore.defaultDataStore().httpCookieStore()` (main thread only).
+fn cookie_store() -> *mut AnyObject {
+    // SAFETY: called from the main thread (via `crate::rt::invoke`), as `WKWebsiteDataStore` requires.
+    unsafe {
+        let store: *mut AnyObject = msg_send![class!(WKWebsiteDataStore), defaultDataStore];
+        msg_send![store, httpCookieStore]
+    }
+}
+
+fn set_key(dict: *mut AnyObject, key: *const AnyObject, value: *mut AnyObject) {
+    // SAFETY: `dict` is a live `NSMutableDictionary`; `key`/`value` are live objects.
+    unsafe {
+        let _: () = msg_send![dict, setObject: value, forKey: key];
+    }
+}
+
+/// Builds an `NSHTTPCookie` from an `ImportedCookie` (`cookieScope.ts`): `{ name, value, domain?, path, secure,
+/// httpOnly, sameSite, expirationDate? }`. Returns `None` when `name`/`value` are missing (the dictionary's only
+/// truly required keys besides a domain, which `url`'s host fills in when `domain` is left out).
+fn build_cookie(data: &serde_json::Value) -> Option<*mut AnyObject> {
+    let name = data.get("name")?.as_str()?;
+    let value = data.get("value")?.as_str()?;
+    let domain = data
+        .get("domain")
+        .and_then(|v| v.as_str())
+        .filter(|d| !d.is_empty())
+        .map(String::from)
+        .or_else(|| data.get("url").and_then(|v| v.as_str()).and_then(url_host))?;
+    let path = data.get("path").and_then(|v| v.as_str()).unwrap_or("/");
+    let secure = data.get("secure").and_then(|v| v.as_bool()).unwrap_or(false);
+    // SAFETY: Foundation classes/selectors, objects kept alive until `cookieWithProperties:` copies what it needs.
+    unsafe {
+        let dict: *mut AnyObject = msg_send![class!(NSMutableDictionary), dictionaryWithCapacity: 6usize];
+        set_key(dict, NSHTTPCookieName, ns_string(name));
+        set_key(dict, NSHTTPCookieValue, ns_string(value));
+        set_key(dict, NSHTTPCookieDomain, ns_string(&domain));
+        set_key(dict, NSHTTPCookiePath, ns_string(path));
+        set_key(dict, NSHTTPCookieSecure, ns_string(if secure { "TRUE" } else { "FALSE" }));
+        if let Some(same_site) = data.get("sameSite").and_then(|v| v.as_str()) {
+            let mapped = match same_site {
+                "lax" => Some("Lax"),
+                "strict" => Some("Strict"),
+                "no_restriction" => Some("None"),
+                _ => None, // "unspecified": omit the key rather than guess.
+            };
+            if let Some(mapped) = mapped {
+                set_key(dict, NSHTTPCookieSameSitePolicy, ns_string(mapped));
+            }
+        }
+        if let Some(expires) = data.get("expirationDate").and_then(|v| v.as_f64()) {
+            let date: *mut AnyObject = msg_send![class!(NSDate), dateWithTimeIntervalSince1970: expires];
+            set_key(dict, NSHTTPCookieExpires, date);
+        }
+        let cookie: *mut AnyObject = msg_send![class!(NSHTTPCookie), cookieWithProperties: dict];
+        (!cookie.is_null()).then_some(cookie)
+    }
+}
+
+/// `new URL(url).hostname`, enough for the cookie's `Domain` when the caller left it out.
+fn url_host(url: &str) -> Option<String> {
+    let rest = url.split("://").nth(1)?;
+    let host = rest.split(['/', '?', '#']).next()?;
+    let host = host.rsplit('@').next()?; // drop `user:pass@`
+    Some(host.split(':').next()?.to_string())
+}
+
+/// `webview.cookies.set { partition, cookie }`: `partition` is accepted, not scoped to (see module doc).
+pub(super) fn set(data: serde_json::Value, call: nsh_engine::HostCall) {
+    let Some(cookie_data) = data.get("cookie") else {
+        call.reject("webview.cookies.set needs a cookie");
+        return;
+    };
+    let Some(cookie) = build_cookie(cookie_data) else {
+        call.reject("webview.cookies.set: the cookie is missing name, value or a domain");
+        return;
+    };
+    let call = Cell::new(Some(call));
+    let block = RcBlock::new(move || {
+        if let Some(call) = call.take() {
+            call.resolve(serde_json::Value::Null);
+        }
+    });
+    // SAFETY: main thread; `cookie` and `block` outlive the call (the block is retained by the method).
+    unsafe {
+        let _: () = msg_send![cookie_store(), setCookie: cookie, completionHandler: &*block];
+    }
+}
+
+/// `webview.cookies.clear { partition, name? }`: every cookie, or only `name`'s.
+pub(super) fn clear(data: serde_json::Value, call: nsh_engine::HostCall) {
+    let name = data.get("name").and_then(|v| v.as_str()).map(String::from);
+    let store = cookie_store();
+    match name {
+        None => {
+            let call = Cell::new(Some(call));
+            let block = RcBlock::new(move || {
+                if let Some(call) = call.take() {
+                    call.resolve(serde_json::Value::Null);
+                }
+            });
+            // SAFETY: main thread; `types`/`date`/`block` outlive the call.
+            unsafe {
+                let types: *mut AnyObject = msg_send![class!(NSArray), arrayWithObject: WKWebsiteDataTypeCookies];
+                let set: *mut AnyObject = msg_send![class!(NSSet), setWithArray: types];
+                let date: *mut AnyObject = msg_send![class!(NSDate), distantPast];
+                let store: *mut AnyObject = msg_send![class!(WKWebsiteDataStore), defaultDataStore];
+                let _: () = msg_send![store, removeDataOfTypes: set, modifiedSince: date, completionHandler: &*block];
+            }
+        }
+        Some(name) => {
+            let call = std::rc::Rc::new(Cell::new(Some(call)));
+            let remaining = std::rc::Rc::new(Cell::new(0usize));
+            // SAFETY: main thread; `block` outlives `getAllCookies`.
+            unsafe {
+                let block = RcBlock::new(move |cookies: *mut AnyObject| {
+                    let count: usize = msg_send![cookies, count];
+                    let mut matches = Vec::new();
+                    for i in 0..count {
+                        let cookie: *mut AnyObject = msg_send![cookies, objectAtIndex: i];
+                        let cookie_name: *mut AnyObject = msg_send![cookie, name];
+                        let c = objc_utf8(cookie_name);
+                        if c.as_deref() == Some(name.as_str()) {
+                            matches.push(cookie);
+                        }
+                    }
+                    if matches.is_empty() {
+                        if let Some(call) = call.take() {
+                            call.resolve(serde_json::Value::Null);
+                        }
+                        return;
+                    }
+                    remaining.set(matches.len());
+                    for cookie in matches {
+                        let call = call.clone();
+                        let remaining = remaining.clone();
+                        let done = RcBlock::new(move || {
+                            remaining.set(remaining.get() - 1);
+                            if remaining.get() == 0
+                                && let Some(call) = call.take()
+                            {
+                                call.resolve(serde_json::Value::Null);
+                            }
+                        });
+                        let _: () = msg_send![cookie_store(), deleteCookie: cookie, completionHandler: &*done];
+                    }
+                });
+                let _: () = msg_send![store, getAllCookies: &*block];
+            }
+        }
+    }
+}
+
+/// `webview.cache.clear { partition }`: every non-cookie website data type.
+pub(super) fn clear_cache(_data: serde_json::Value, call: nsh_engine::HostCall) {
+    let call = Cell::new(Some(call));
+    let block = RcBlock::new(move || {
+        if let Some(call) = call.take() {
+            call.resolve(serde_json::Value::Null);
+        }
+    });
+    // SAFETY: main thread; `types`/`date`/`block` outlive the call.
+    unsafe {
+        let members: [*const AnyObject; 6] = [
+            WKWebsiteDataTypeDiskCache,
+            WKWebsiteDataTypeMemoryCache,
+            WKWebsiteDataTypeOfflineWebApplicationCache,
+            WKWebsiteDataTypeLocalStorage,
+            WKWebsiteDataTypeSessionStorage,
+            WKWebsiteDataTypeIndexedDBDatabases,
+        ];
+        let array: *mut AnyObject = msg_send![class!(NSMutableArray), arrayWithCapacity: members.len() + 1];
+        for member in members {
+            let _: () = msg_send![array, addObject: member];
+        }
+        let _: () = msg_send![array, addObject: WKWebsiteDataTypeServiceWorkerRegistrations];
+        let set: *mut AnyObject = msg_send![class!(NSSet), setWithArray: array];
+        let date: *mut AnyObject = msg_send![class!(NSDate), distantPast];
+        let store: *mut AnyObject = msg_send![class!(WKWebsiteDataStore), defaultDataStore];
+        let _: () = msg_send![store, removeDataOfTypes: set, modifiedSince: date, completionHandler: &*block];
+    }
+}
+
+/// An `NSString`'s UTF-8 text, or `None` for a null object.
+fn objc_utf8(s: *mut AnyObject) -> Option<String> {
+    if s.is_null() {
+        return None;
+    }
+    // SAFETY: `s` is a live `NSString` for the duration of this call.
+    unsafe {
+        let utf8: *const std::ffi::c_char = msg_send![s, UTF8String];
+        (!utf8.is_null()).then(|| std::ffi::CStr::from_ptr(utf8).to_string_lossy().into_owned())
+    }
+}
