+// --- Patch 0011: the selection, as the app asks for it (`crate::selection_host`) ----------
+
+/// One text's part of a selection or mark.
+pub(crate) struct Part {
+    pub(crate) view: NshView,
+    pub(crate) text: Arc<AttributedText>,
+    /// From the text view's coordinates to the root's.
+    pub(crate) to_root: Mat4,
+    pub(crate) range: (u32, u32),
+}
+
+/// The texts of `view`'s subtree in document order, as an area lists them
+/// (`selectable={false}` texts left out): each view, its text, its
+/// transform to the root.
+pub(crate) fn texts_of(view: &NshView) -> Vec<(NshView, Arc<AttributedText>, Mat4)> {
+    AreaTexts::of(view)
+        .map(|t| {
+            t.texts
+                .into_iter()
+                .map(|t| (t.view, t.text, t.to_root))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// The active area's selection: its surface, the area, the button is still
+/// down, the selected text and each text's part, in document order.
+pub(crate) fn selected_parts() -> Option<(u64, NshView, bool, String, Vec<Part>)> {
+    ACTIVE.with_borrow(|active| {
+        let a = active.as_ref()?;
+        if a.model.is_empty() || !a.area.attached() {
+            return None;
+        }
+        let texts = AreaTexts::of(&a.area)?;
+        let parts: Vec<Part> = a
+            .model
+            .ranges(&texts)
+            .into_iter()
+            .map(|(i, range)| {
+                let t = &texts.texts[i];
+                Part {
+                    view: t.view.clone(),
+                    text: t.text.clone(),
+                    to_root: t.to_root,
+                    range: (range.start, range.end),
+                }
+            })
+            .collect();
+        if parts.is_empty() {
+            return None;
+        }
+        Some((
+            a.surface,
+            a.area.clone(),
+            a.gesture.is_some(),
+            a.model.text(&texts),
+            parts,
+        ))
+    })
+}
diff --git a/crates/gpui/nsh-platform-gpui/src/selection_host.rs b/crates/gpui/nsh-platform-gpui/src/selection_host.rs
new file mode 100644
index 0000000..e117cf4
--- /dev/null
+++ b/crates/gpui/nsh-platform-gpui/src/selection_host.rs
@@ -0,0 +1,456 @@
+//! The selection of selectable text, for the app (patch 0011): what a web
+//! page reads from `window.getSelection()` and draws with CSS highlights,
+//! asked of the host by name.
+//!
+//! Calls (`host.call(name, data)`):
+//! - `selection.capabilities`: the names below, so an app asks once.
+//! - `selection.watch` (`{ sourcePrefix?: string | null, copyHook?: bool }`):
+//!   starts `selection.changed` events. `sourcePrefix` names the `testID`s
+//!   (a prefix) that mark a selection's source (the nearest view around the
+//!   selection's first text whose `testID` starts with it); `copyHook` true
+//!   makes Cmd/Ctrl+C and the Copy menu item send `selection.copy` instead
+//!   of writing the clipboard (the app writes it, as Markdown say).
+//! - `selection.get`: the selection now, as `selection.changed` says it.
+//! - `selection.clear`: clears it.
+//! - `selection.texts` (`{ testId }`): the texts of the view with that
+//!   `testID`, in document order, and its frame (window points).
+//! - `selection.mark` (`{ testId, start: {text, offset}, end: {text, offset},
+//!   color?: "#rrggbb", alpha?: 0..1 } | null`): draws a range of those texts
+//!   in `color` at `alpha` under the selection (one mark at a time; `null`
+//!   clears it); resolves the range's rectangles, or null when the view or
+//!   the range is not there.
+//!
+//! Events (`host.on(name)`):
+//! - `selection.changed`: `{ empty: true }` or `{ empty: false, kind: "area" |
+//!   "text", text, pointerDown, rect, rects, runs, source }`: the selected
+//!   text; whether the mouse button is still down; the selection's bounds and
+//!   each line's rectangle in window points (top left of the window's
+//!   content, y down); `runs` the selected text's style runs (`text`, `bold`,
+//!   `italic`, `strike`, `underline`, `mono`, `testId`, with `block` the text
+//!   index); `source` the `{ testId, texts, start, end }` of the selection in
+//!   its source's texts (`sourcePrefix`), or null.
+//! - `selection.copy`: the selection, as above, when the copy hook is on.
+
+use std::{
+    cell::{Cell, RefCell},
+    sync::{
+        OnceLock,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+use nsh_core::{AttributedText, Color};
+use nsh_engine::{HostCall, HostChannel};
+use serde_json::{Value, json};
+
+use crate::{geom::Mat4, selectable_view::Part, surface::Surface, view::NshView};
+
+const CALLS: [&str; 6] = [
+    "selection.watch",
+    "selection.get",
+    "selection.clear",
+    "selection.texts",
+    "selection.mark",
+    "selection.capabilities",
+];
+
+/// The most line rectangles an event carries.
+const MAX_RECTS: usize = 400;
+
+static HOST: OnceLock<HostChannel> = OnceLock::new();
+static WATCHING: AtomicBool = AtomicBool::new(false);
+static COPY_HOOK: AtomicBool = AtomicBool::new(false);
+static PREFIX: std::sync::Mutex<Option<String>> = std::sync::Mutex::new(None);
+
+thread_local! {
+    /// A `selection.changed` is on its way.
+    static SCHEDULED: Cell<bool> = const { Cell::new(false) };
+    /// The last event sent, so an unchanged selection is not sent again.
+    static LAST: RefCell<String> = const { RefCell::new(String::new()) };
+    /// The texts with a mark.
+    static MARKED: RefCell<Vec<NshView>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Registers the calls on `host`.
+pub(crate) fn install(host: &HostChannel) {
+    let _ = HOST.set(host.clone());
+    host.handle("selection.capabilities", |call| {
+        call.resolve(Value::Array(CALLS.iter().map(|n| Value::from(*n)).collect()));
+    });
+    host.handle("selection.watch", |call| {
+        let data = call.data();
+        let prefix = data
+            .get("sourcePrefix")
+            .and_then(Value::as_str)
+            .filter(|p| !p.is_empty())
+            .map(str::to_owned);
+        *PREFIX.lock().unwrap_or_else(|e| e.into_inner()) = prefix;
+        COPY_HOOK.store(
+            data.get("copyHook").and_then(Value::as_bool).unwrap_or(false),
+            Ordering::Relaxed,
+        );
+        WATCHING.store(true, Ordering::Relaxed);
+        call.resolve(Value::Null);
+        crate::rt::invoke(|| {
+            LAST.with_borrow_mut(String::clear);
+            changed();
+        });
+    });
+    host.handle("selection.get", |call| on_main(call, |_| snapshot()));
+    host.handle("selection.clear", |call| {
+        on_main(call, |_| {
+            crate::selectable_view::clear_all();
+            crate::text::clear_selection();
+            Value::Null
+        })
+    });
+    host.handle("selection.texts", |call| on_main(call, texts));
+    host.handle("selection.mark", |call| on_main(call, mark));
+}
+
+/// Answers `call` with `f(data)` on the main thread.
+fn on_main(call: HostCall, f: fn(&Value) -> Value) {
+    crate::rt::invoke(move || {
+        let value = f(call.data());
+        call.resolve(value);
+    });
+}
+
+/// The selection may have changed: sends `selection.changed` soon (once
+/// for a burst of changes, as a drag makes).
+pub(crate) fn changed() {
+    if !WATCHING.load(Ordering::Relaxed) || SCHEDULED.replace(true) {
+        return;
+    }
+    crate::rt::after_ms(16, || {
+        SCHEDULED.set(false);
+        let value = snapshot();
+        let text = value.to_string();
+        let same = LAST.with_borrow_mut(|last| {
+            if *last == text {
+                true
+            } else {
+                *last = text;
+                false
+            }
+        });
+        if !same && let Some(host) = HOST.get() {
+            let _ = host.send("selection.changed", value);
+        }
+    });
+}
+
+/// Copies `text`, the selection's: to the clipboard, or to the app when its
+/// copy hook is on.
+pub(crate) fn copy(text: &str) {
+    if COPY_HOOK.load(Ordering::Relaxed)
+        && let Some(host) = HOST.get()
+        && host.send("selection.copy", snapshot()).is_ok()
+    {
+        return;
+    }
+    crate::system::set_clipboard_text(text);
+}
+
+fn prefix() -> Option<String> {
+    PREFIX.lock().unwrap_or_else(|e| e.into_inner()).clone()
+}
+
+/// The selection now.
+fn snapshot() -> Value {
+    if let Some((_, _, down, text, parts)) = crate::selectable_view::selected_parts() {
+        return describe("area", text, down, &parts);
+    }
+    if let Some((_, view, (a, b))) = crate::text::selected_range()
+        && view.attached()
+        && let Some(to_root) = view.to_root()
+    {
+        let Some(drawn) = view.state().text.as_ref().map(|t| t.text.clone()) else {
+            return json!({ "empty": true });
+        };
+        let text = utf16_slice(&drawn.text, a, b).replace(nsh_core::ATTACHMENT_CHAR, "");
+        let part = Part {
+            view: view.clone(),
+            text: drawn,
+            to_root,
+            range: (a, b),
+        };
+        return describe("text", text, false, std::slice::from_ref(&part));
+    }
+    json!({ "empty": true })
+}
+
+fn utf16_slice(text: &str, a: u32, b: u32) -> String {
+    let units: Vec<u16> = text.encode_utf16().collect();
+    let end = (b as usize).min(units.len());
+    let start = (a as usize).min(end);
+    String::from_utf16_lossy(&units[start..end])
+}
+
+/// Window rectangles of `part`'s range.
+fn part_rects(part: &Part, out: &mut Vec<[f32; 4]>) {
+    let local = crate::text::range_rects(&part.view.state(), part.range.0, part.range.1);
+    for (x, y, w, h) in local {
+        if out.len() >= MAX_RECTS {
+            return;
+        }
+        if let Some(r) = to_window(&part.to_root, x, y, w, h) {
+            out.push(r);
+        }
+    }
+}
+
+fn to_window(m: &Mat4, x: f32, y: f32, w: f32, h: f32) -> Option<[f32; 4]> {
+    let (x0, y0) = m.map(x, y)?;
+    let (x1, y1) = m.map(x + w, y + h)?;
+    Some([x0.min(x1), y0.min(y1), (x1 - x0).abs(), (y1 - y0).abs()])
+}
+
+fn union(rects: &[[f32; 4]]) -> Value {
+    let Some(first) = rects.first() else {
+        return Value::Null;
+    };
+    let (mut x0, mut y0, mut x1, mut y1) = (first[0], first[1], first[0] + first[2], first[1] + first[3]);
+    for r in rects {
+        x0 = x0.min(r[0]);
+        y0 = y0.min(r[1]);
+        x1 = x1.max(r[0] + r[2]);
+        y1 = y1.max(r[1] + r[3]);
+    }
+    rect_json(&[x0, y0, x1 - x0, y1 - y0])
+}
+
+fn rect_json(r: &[f32; 4]) -> Value {
+    json!({ "x": r[0], "y": r[1], "width": r[2], "height": r[3] })
+}
+
+/// The nearest `testID` around `view` (itself first), and its view.
+fn test_id_around(view: &NshView, prefix: Option<&str>) -> Option<(NshView, String)> {
+    let mut current = Some(view.clone());
+    while let Some(v) = current {
+        let id = v.state().props.test_id.clone();
+        if let Some(id) = id
+            && prefix.is_none_or(|p| id.starts_with(p))
+        {
+            return Some((v, id.to_string()));
+        }
+        current = v.parent_view();
+    }
+    None
+}
+
+/// The style runs of `text`'s `a..b`.
+fn runs(block: usize, text: &AttributedText, (a, b): (u32, u32), out: &mut Vec<Value>) {
+    let mut cuts = vec![a, b];
+    for span in &text.spans {
+        for at in [span.start, span.end] {
+            if at > a && at < b {
+                cuts.push(at);
+            }
+        }
+    }
+    for id in &text.test_ids {
+        for at in [id.start, id.end] {
+            if at > a && at < b {
+                cuts.push(at);
+            }
+        }
+    }
+    cuts.sort_unstable();
+    cuts.dedup();
+    for pair in cuts.windows(2) {
+        let (s, e) = (pair[0], pair[1]);
+        let piece = utf16_slice(&text.text, s, e).replace(nsh_core::ATTACHMENT_CHAR, "");
+        let style = text
+            .spans
+            .iter()
+            .find(|span| s >= span.start && s < span.end)
+            .map(|span| span.style);
+        let test_id = text
+            .test_ids
+            .iter()
+            .filter(|t| s >= t.start && s < t.end)
+            .min_by_key(|t| t.end - t.start)
+            .map(|t| t.test_id.to_string());
+        let mono = style
+            .and_then(|st| st.font_family)
+            .map(|f| f.name().to_ascii_lowercase())
+            .is_some_and(|n| n.contains("mono") || n.contains("menlo") || n.contains("courier"));
+        out.push(json!({
+            "block": block,
+            "text": piece,
+            "bold": style.is_some_and(|st| st.font_weight >= 600),
+            "italic": style.is_some_and(|st| st.italic),
+            "strike": style.is_some_and(|st| st.decoration.line_through),
+            "underline": style.is_some_and(|st| st.decoration.underline),
+            "mono": mono,
+            "testId": test_id,
+        }));
+    }
+}
+
+fn describe(kind: &str, text: String, down: bool, parts: &[Part]) -> Value {
+    let mut rects = Vec::new();
+    let mut style_runs = Vec::new();
+    for (i, part) in parts.iter().enumerate() {
+        part_rects(part, &mut rects);
+        runs(i, &part.text, part.range, &mut style_runs);
+    }
+    let prefix = prefix();
+    let source = parts.first().and_then(|first| {
+        let (view, id) = test_id_around(&first.view, prefix.as_deref())?;
+        let texts = crate::selectable_view::texts_of(&view);
+        let index = |v: &NshView| texts.iter().position(|(t, _, _)| t == v);
+        let mut start = None;
+        let mut end = None;
+        for part in parts {
+            if let Some(i) = index(&part.view) {
+                if start.is_none() {
+                    start = Some(json!({ "text": i, "offset": part.range.0 }));
+                }
+                end = Some(json!({ "text": i, "offset": part.range.1 }));
+            }
+        }
+        Some(json!({
+            "testId": id,
+            "texts": texts.iter().map(|(_, t, _)| Value::from(t.text.clone())).collect::<Vec<_>>(),
+            "start": start?,
+            "end": end?,
+        }))
+    });
+    json!({
+        "empty": false,
+        "kind": kind,
+        "text": text,
+        "pointerDown": down,
+        "rect": union(&rects),
+        "rects": rects.iter().map(rect_json).collect::<Vec<_>>(),
+        "runs": style_runs,
+        "source": source,
+    })
+}
+
+/// The view with `testID` `id` on any surface.
+fn find(id: &str) -> Option<NshView> {
+    fn walk(view: &NshView, id: &str) -> Option<NshView> {
+        {
+            let s = view.state();
+            if s.style.hidden {
+                return None;
+            }
+            if s.props.test_id.as_deref() == Some(id) {
+                return Some(view.clone());
+            }
+        }
+        view.with_children(|children| children.iter().find_map(|c| walk(c, id)))
+    }
+    Surface::all().iter().find_map(|s| walk(&s.root, id))
+}
+
+fn frame_json(view: &NshView) -> Value {
+    let Some(m) = view.to_root() else {
+        return Value::Null;
+    };
+    let (w, h) = {
+        let s = view.state();
+        (s.frame.size.width.0, s.frame.size.height.0)
+    };
+    to_window(&m, 0.0, 0.0, w, h).map_or(Value::Null, |r| rect_json(&r))
+}
+
+/// `selection.texts`.
+fn texts(data: &Value) -> Value {
+    let Some(view) = data.get("testId").and_then(Value::as_str).and_then(find) else {
+        return Value::Null;
+    };
+    let texts = crate::selectable_view::texts_of(&view);
+    json!({
+        "texts": texts.iter().map(|(_, t, _)| Value::from(t.text.clone())).collect::<Vec<_>>(),
+        "frame": frame_json(&view),
+    })
+}
+
+fn clear_marks() {
+    for view in MARKED.with_borrow_mut(std::mem::take) {
+        crate::text::set_mark(&view, None);
+    }
+}
+
+fn position(value: Option<&Value>) -> Option<(usize, u32)> {
+    let v = value?;
+    Some((
+        v.get("text")?.as_u64()? as usize,
+        v.get("offset")?.as_u64()? as u32,
+    ))
+}
+
+fn parse_color(value: Option<&Value>, alpha: f32) -> Color {
+    let base = value
+        .and_then(Value::as_str)
+        .and_then(|s| s.strip_prefix('#'))
+        .filter(|s| s.len() == 6)
+        .and_then(|s| u32::from_str_radix(s, 16).ok())
+        .map_or(Color::rgba(0x35, 0x84, 0xe4, 0xff), |v| {
+            Color::rgba((v >> 16) as u8, (v >> 8) as u8, v as u8, 0xff)
+        });
+    base.with_alpha(alpha.clamp(0.0, 1.0))
+}
+
+/// `selection.mark`.
+fn mark(data: &Value) -> Value {
+    if data.is_null() {
+        clear_marks();
+        return Value::Null;
+    }
+    let Some(view) = data.get("testId").and_then(Value::as_str).and_then(find) else {
+        clear_marks();
+        return Value::Null;
+    };
+    let (Some(start), Some(end)) = (position(data.get("start")), position(data.get("end"))) else {
+        clear_marks();
+        return Value::Null;
+    };
+    if end < start {
+        clear_marks();
+        return Value::Null;
+    }
+    let alpha = data.get("alpha").and_then(Value::as_f64).unwrap_or(0.45) as f32;
+    let color = parse_color(data.get("color"), alpha);
+    let texts = crate::selectable_view::texts_of(&view);
+    let mut marked = Vec::new();
+    let mut rects = Vec::new();
+    for (i, (v, t, m)) in texts.iter().enumerate() {
+        if i < start.0 || i > end.0 {
+            continue;
+        }
+        let len = t.len_utf16();
+        let a = if i == start.0 { start.1.min(len) } else { 0 };
+        let b = if i == end.0 { end.1.min(len) } else { len };
+        if a >= b {
+            continue;
+        }
+        crate::text::set_mark(v, Some((a, b, color)));
+        marked.push(v.clone());
+        let part = Part {
+            view: v.clone(),
+            text: t.clone(),
+            to_root: *m,
+            range: (a, b),
+        };
+        part_rects(&part, &mut rects);
+    }
+    let old = MARKED.with_borrow_mut(|m| std::mem::replace(m, marked.clone()));
+    for v in old {
+        if !marked.contains(&v) {
+            crate::text::set_mark(&v, None);
+        }
+    }
+    if marked.is_empty() {
+        return Value::Null;
+    }
+    json!({
+        "rect": union(&rects),
+        "rects": rects.iter().map(rect_json).collect::<Vec<_>>(),
+        "frame": frame_json(&view),
+    })
+}
