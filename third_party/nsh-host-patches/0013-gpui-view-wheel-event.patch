+thread_local! {
+    /// A touchpad pinch that began over an `onWheel` view goes to it as
+    /// Ctrl + wheel deltas until it ends, as browsers send pinches (0012).
+    static WHEEL_PINCH: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// The nearest view under `(x, y)` listening to `onWheel`.
+fn wheel_view(surface: &Rc<Surface>, x: f32, y: f32) -> Option<NshView> {
+    let hit = pick(&surface.root, x, y, true)?;
+    chain(&hit.view)
+        .into_iter()
+        .find(|v| v.state().events.contains(EventKind::Wheel))
+}
+
+/// A pinch over an `onWheel` view: Ctrl + wheel with `deltaY = -100 * delta`
+/// (e^(0.01 * 100 * delta) follows the pinch's scale). True when taken.
+fn wheel_pinch(surface: &Rc<Surface>, x: f32, y: f32, delta: f32, phase: GesturePhase) -> bool {
+    if phase == GesturePhase::Began {
+        let over = wheel_view(surface, x, y).is_some();
+        WHEEL_PINCH.with(|p| p.set(over));
+    }
+    if !WHEEL_PINCH.with(|p| p.get()) {
+        return false;
+    }
+    if delta != 0.0 {
+        let modifiers = Modifiers { ctrl: true, ..surface.input.modifiers.get() };
+        let event = WheelEvent { x, y, dx: 0.0, dy: -100.0 * delta, precise: true, modifiers, time: 0.0 };
+        wheel_listener(surface, &event);
+    }
+    if matches!(phase, GesturePhase::Ended | GesturePhase::Cancelled) {
+        WHEEL_PINCH.with(|p| p.set(false));
+    }
+    true
+}
+
+/// Gives the wheel `event` to the nearest view under the pointer listening
+/// to `onWheel` (patch 0012): it takes it, and no scroll view scrolls.
+fn wheel_listener(surface: &Rc<Surface>, event: &WheelEvent) -> bool {
+    if event.dx == 0.0 && event.dy == 0.0 {
+        return false;
+    }
+    let Some(view) = wheel_view(surface, event.x, event.y) else {
+        return false;
+    };
+    let id = view.state().id;
+    let (lx, ly) = local(&view, event.x, event.y);
+    let point = |x: f32, y: f32| {
+        let mut m = serde_json::Map::new();
+        m.insert("x".into(), serde_json::Value::from(f64::from(x)));
+        m.insert("y".into(), serde_json::Value::from(f64::from(y)));
+        serde_json::Value::Object(m)
+    };
+    let mods = event.modifiers.core();
+    let mut modifiers = serde_json::Map::new();
+    modifiers.insert("control".into(), mods.ctrl.into());
+    modifiers.insert("alt".into(), mods.alt.into());
+    modifiers.insert("shift".into(), mods.shift.into());
+    modifiers.insert("platform".into(), mods.cmd.into());
+    let mut payload = serde_json::Map::new();
+    payload.insert("position".into(), point(lx, ly));
+    payload.insert("pagePosition".into(), point(event.x, event.y));
+    payload.insert("deltaX".into(), serde_json::Value::from(f64::from(event.dx)));
+    payload.insert("deltaY".into(), serde_json::Value::from(f64::from(event.dy)));
+    payload.insert("precise".into(), event.precise.into());
+    payload.insert("modifiers".into(), serde_json::Value::Object(modifiers));
+    surface.event(id, EventKind::Wheel, EventPayload::Json(serde_json::Value::Object(payload)));
+    true
+}
