+    /// Scroll view `scroll` moved its content (patch 0013): the hints
+    /// anchored inside it that wait or show hide, unless the keyboard focus
+    /// is in their anchor (`TooltipScrollDismissArea`'s `dismissUnfocused`
+    /// in T3 Code: content scrolling under a resting pointer moves the
+    /// anchor away from it without a `MouseLeave`, so the hint would stay).
+    /// They show again once the pointer leaves and comes back.
+    pub(super) fn scroll_dismiss_hints(&mut self, scroll: Key) {
+        let hints: Vec<(Key, Key)> = self
+            .overlays
+            .iter()
+            .copied()
+            .filter(|&k| {
+                self.overlay(k)
+                    .is_some_and(|s| s.config.hint.is_some() && (s.hinted || s.waiting.is_some()))
+            })
+            .filter_map(|k| self.hint_anchor(k).map(|anchor| (k, anchor)))
+            .collect();
+        for (key, anchor) in hints {
+            let mut inside = false;
+            let mut at = self.nodes[anchor as usize].parent;
+            while at != NO_KEY {
+                if at == scroll {
+                    inside = true;
+                    break;
+                }
+                at = self.nodes[at as usize].parent;
+            }
+            if !inside {
+                continue;
+            }
+            let anchor_id = self.nodes[anchor as usize].id;
+            if self.has_focus_within(anchor_id) {
+                continue;
+            }
+            self.unhint(key);
+        }
+    }
+
