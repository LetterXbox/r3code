+#[test]
+fn focus_within_change_is_an_event_for_the_views_listening() {
+    use crate::tailwind::state::FOCUSED;
+    // Patch 0013: a region (2) hears the focus come into a view in it (6)
+    // and leave it; a view around it that does not listen (ROOT) hears nothing.
+    let mut c = core();
+    views(&mut c, &[(2, ROOT_ID, ""), (4, 2, ""), (6, 4, "")]);
+    apply(
+        &mut c,
+        vec![Op::Listen {
+            id: 2,
+            event: EventKind::FocusWithin,
+            enabled: true,
+        }],
+    );
+    c.commit();
+    let _ = js_events(&mut c);
+    c.set_states(6, FOCUSED);
+    c.commit();
+    let focus = |events: Vec<(NodeId, EventKind, EventPayload)>| -> Vec<(NodeId, String)> {
+        events
+            .into_iter()
+            .filter(|(_, k, _)| *k == EventKind::FocusWithin)
+            .map(|(id, _, p)| (id, format!("{p:?}")))
+            .collect()
+    };
+    let got = focus(js_events(&mut c));
+    assert_eq!(got.len(), 1, "{got:?}");
+    assert!(got[0].0 == 2 && got[0].1.contains("true"), "{got:?}");
+    c.set_states(6, 0);
+    c.commit();
+    let got = focus(js_events(&mut c));
+    assert_eq!(got.len(), 1, "{got:?}");
+    assert!(got[0].0 == 2 && got[0].1.contains("false"), "{got:?}");
+}
