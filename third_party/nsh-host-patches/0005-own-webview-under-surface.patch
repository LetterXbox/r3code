@@ -0,0 +1,368 @@
+//! Web views under GPUI's surface (macOS).
+//!
+//! GPUI draws a window into one Metal layer, the layer of its view
+//! (`GPUIView`, a child of the window's content view), and a native view
+//! added to the window sits above everything that layer shows. Here a web
+//! view goes the other way round:
+//!
+//! - **Under.** The `WKWebView` is moved out of GPUI's view into the
+//!   window's content view, *below* GPUI's view ([`attach`]).
+//! - **A hole.** The window and GPUI's layer are made non-opaque
+//!   (`WindowBackgroundAppearance::Transparent`; the surface still fills
+//!   its background), and the web view's item draws a quad that erases
+//!   what the frame holds under it ([`crate::render::DrawCx::clear_rect`],
+//!   drawn by the patched `gpui-fast-apple` with a destination-out blend):
+//!   the page shows through the layer there. What nsh draws later (menus,
+//!   dialogs, tooltips, toasts, drag images) covers the page as it covers
+//!   any other content.
+//! - **The mouse.** GPUI's view is above the page, so it gets a `hitTest:`
+//!   ([`install_hit_test`]) that answers `nil` where the innermost nsh view
+//!   under the point is a web view shown this way
+//!   ([`crate::input::web_under`]): AppKit then finds the web view below.
+//!   Presses, the wheel, drags and context menus go to the page; GPUI's
+//!   listeners treat such a point as outside the surface
+//!   ([`crate::events`]).
+//! - **In step.** The web view's frame is set in the prepaint of the frame
+//!   that draws the hole, and that frame is presented with the Core
+//!   Animation transaction that moves the view ([`sync`]: the layer's
+//!   `presentsWithTransaction` for the frames around a move), so the page
+//!   and the hole move together.
+//!
+//! `NSH_WEBVIEW_ABOVE=1` in the environment keeps web views above GPUI's
+//! content, as before.
+
+use std::{
+    cell::RefCell,
+    ptr,
+    rc::{Rc, Weak},
+    sync::OnceLock,
+};
+
+use gpui::{Bounds, Pixels, Window};
+use objc2::{
+    class,
+    encode::{Encode, Encoding},
+    msg_send,
+    runtime::{AnyObject, Bool, Imp, Sel},
+    sel,
+};
+
+use crate::surface::Surface;
+
+/// How many frames after a web view moved are still presented with the
+/// transaction.
+const SYNC_FRAMES: u8 = 20;
+
+/// `NSWindowBelow`.
+const BELOW: isize = -1;
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct CGPoint {
+    x: f64,
+    y: f64,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct CGSize {
+    width: f64,
+    height: f64,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct CGRect {
+    origin: CGPoint,
+    size: CGSize,
+}
+
+// SAFETY: the layouts and encodings are CoreGraphics' on 64-bit Apple
+// targets (two doubles; two of those).
+unsafe impl Encode for CGPoint {
+    const ENCODING: Encoding = Encoding::Struct("CGPoint", &[f64::ENCODING, f64::ENCODING]);
+}
+// SAFETY: as above.
+unsafe impl Encode for CGSize {
+    const ENCODING: Encoding = Encoding::Struct("CGSize", &[f64::ENCODING, f64::ENCODING]);
+}
+// SAFETY: as above.
+unsafe impl Encode for CGRect {
+    const ENCODING: Encoding = Encoding::Struct("CGRect", &[CGPoint::ENCODING, CGSize::ENCODING]);
+}
+
+thread_local! {
+    /// GPUI views with web views under them, and the surfaces drawn in
+    /// them (main thread only).
+    static VIEWS: RefCell<Vec<(usize, Weak<Surface>)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// True unless the environment asks for web views above GPUI's content.
+pub(crate) fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("NSH_WEBVIEW_ABOVE").is_none_or(|v| v.is_empty() || v == "0"))
+}
+
+/// True when `/tmp/nsh-webview-debug` exists: hit tests are logged.
+pub(super) fn debug() -> bool {
+    static DEBUG: OnceLock<bool> = OnceLock::new();
+    *DEBUG.get_or_init(|| std::path::Path::new("/tmp/nsh-webview-debug").exists())
+}
+
+/// GPUI's view of `window`.
+fn gpui_view(window: &Window) -> Option<*mut AnyObject> {
+    use raw_window_handle::{HasWindowHandle, RawWindowHandle};
+    match HasWindowHandle::window_handle(window).ok()?.as_raw() {
+        RawWindowHandle::AppKit(handle) => Some(handle.ns_view.as_ptr().cast()),
+        _ => None,
+    }
+}
+
+/// Moves the web view `web` (a `WKWebView` wry built as a child of GPUI's
+/// view) under GPUI's view, and prepares the window for it. False when the
+/// window has no place for it (the web view stays where it was).
+pub(crate) fn attach(window: &mut Window, surface: &Rc<Surface>, web: *mut AnyObject) -> bool {
+    if !enabled() || web.is_null() {
+        return false;
+    }
+    let Some(view) = gpui_view(window) else {
+        return false;
+    };
+    // SAFETY: `view` is GPUI's live view and `web` the live web view wry
+    // holds; this runs on the main thread (a window update).
+    unsafe {
+        let content: *mut AnyObject = msg_send![view, superview];
+        if content.is_null() {
+            return false;
+        }
+        // The content view keeps the web view alive across the move (wry
+        // holds it as well).
+        let _: () = msg_send![content, addSubview: web, positioned: BELOW, relativeTo: view];
+        install_hit_test(view);
+    }
+    VIEWS.with_borrow_mut(|views| {
+        views.retain(|(_, s)| s.strong_count() > 0);
+        let known = views
+            .iter()
+            .any(|(v, s)| *v == view as usize && s.as_ptr() == Rc::as_ptr(surface));
+        if !known {
+            views.push((view as usize, Rc::downgrade(surface)));
+        }
+    });
+    if !surface.native.web_transparent.replace(true) {
+        // The layer no longer hides what is under it; the surface's own
+        // background fill keeps the window opaque everywhere else.
+        window.set_background_appearance(gpui::WindowBackgroundAppearance::Transparent);
+    }
+    true
+}
+
+/// Shows `web` at `document` (window coordinates, GPUI's): its frame in
+/// the content view, grown to whole device pixels so that the hole drawn
+/// over it never reaches past it.
+pub(crate) fn place(web: *mut AnyObject, document: Bounds<Pixels>, scale: f32) {
+    let scale = f64::from(scale.max(0.5));
+    let out = |v: f64, up: bool| {
+        let d = v * scale;
+        (if up { (d - 0.01).ceil() } else { (d + 0.01).floor() }) / scale
+    };
+    let left = out(f64::from(f32::from(document.origin.x)), false);
+    let top = out(f64::from(f32::from(document.origin.y)), false);
+    let right = out(f64::from(f32::from(document.right())), true);
+    let bottom = out(f64::from(f32::from(document.bottom())), true);
+    // SAFETY: `web` is the live web view (main thread).
+    unsafe {
+        let parent: *mut AnyObject = msg_send![web, superview];
+        if parent.is_null() {
+            return;
+        }
+        let bounds: CGRect = msg_send![parent, bounds];
+        let flipped: Bool = msg_send![parent, isFlipped];
+        let y = if flipped.as_bool() {
+            top
+        } else {
+            bounds.size.height - bottom
+        };
+        let frame = CGRect {
+            origin: CGPoint { x: left, y },
+            size: CGSize {
+                width: (right - left).max(0.0),
+                height: (bottom - top).max(0.0),
+            },
+        };
+        let old: CGRect = msg_send![web, frame];
+        if old != frame {
+            let _: () = msg_send![web, setFrame: frame];
+        }
+        let _: () = msg_send![web, setHidden: false];
+    }
+}
+
+/// Presents the frame being drawn (and the next few) with the Core
+/// Animation transaction of this turn of the run loop: a web view moved,
+/// shown or hidden now changes on screen with the frame that draws its
+/// hole. Call before the frame is drawn (prepaint or paint).
+pub(crate) fn sync(surface: &Surface, window: &Window) {
+    if surface.native.web_sync.replace(SYNC_FRAMES) == 0 {
+        present_with_transaction(window, true);
+    }
+}
+
+/// A frame of `surface` starts: counts down the frames [`sync`] asked for.
+pub(crate) fn frame(surface: &Surface, window: &Window) {
+    let left = surface.native.web_sync.get();
+    if left == 0 {
+        return;
+    }
+    surface.native.web_sync.set(left - 1);
+    if left == 1 {
+        present_with_transaction(window, false);
+    }
+}
+
+fn present_with_transaction(window: &Window, on: bool) {
+    let Some(view) = gpui_view(window) else {
+        return;
+    };
+    // SAFETY: GPUI's live view on the main thread; its layer is the
+    // CAMetalLayer GPUI draws into.
+    unsafe {
+        if !on {
+            // GPUI presents with the transaction itself while the window is
+            // resized.
+            let resizing: Bool = msg_send![view, inLiveResize];
+            if resizing.as_bool() {
+                return;
+            }
+        }
+        let layer: *mut AnyObject = msg_send![view, layer];
+        if layer.is_null() {
+            return;
+        }
+        let responds: Bool =
+            msg_send![layer, respondsToSelector: sel!(setPresentsWithTransaction:)];
+        if responds.as_bool() {
+            let _: () = msg_send![layer, setPresentsWithTransaction: on];
+        }
+    }
+}
+
+/// Gives GPUI's view a `hitTest:` that lets points on a web view under
+/// the surface through: the view becomes an instance of a subclass of its
+/// class made here, which has the method.
+///
+/// Adding the method to GPUI's own class does not do: AppKit decides once
+/// per class whether a view's `hitTest:` is its own, and routes presses
+/// and the wheel past a method added afterwards (only tracking areas ask
+/// it). A class registered with the method is asked every time.
+///
+/// # Safety
+///
+/// `view` is a live `NSView` (main thread).
+unsafe fn install_hit_test(view: *mut AnyObject) {
+    const NAME: &std::ffi::CStr = c"NshWebUnderGPUIView";
+    // SAFETY: the caller's contract. The subclass adds no ivars, so an
+    // instance of the class is a valid instance of it; `hitTest:` has
+    // `NSView`'s signature.
+    unsafe {
+        let class = objc2::ffi::object_getClass(view.cast_const());
+        if class.is_null() {
+            return;
+        }
+        let mut sub = objc2::ffi::objc_getClass(NAME.as_ptr()).cast_mut();
+        if sub.is_null() {
+            sub = objc2::ffi::objc_allocateClassPair(class, NAME.as_ptr(), 0);
+            if sub.is_null() {
+                log::warn!("web view: no class for GPUI's view; pages take no mouse");
+                return;
+            }
+            let imp: Imp = std::mem::transmute::<
+                unsafe extern "C-unwind" fn(*mut AnyObject, Sel, CGPoint) -> *mut AnyObject,
+                Imp,
+            >(hit_test);
+            objc2::ffi::class_addMethod(sub, sel!(hitTest:), imp, c"@@:{CGPoint=dd}".as_ptr());
+            objc2::ffi::objc_registerClassPair(sub);
+        }
+        if class == sub.cast_const() {
+            return;
+        }
+        // Only a view of the class the subclass was made from.
+        if objc2::ffi::class_getSuperclass(sub) != class {
+            log::warn!("web view: GPUI's view is of another class; pages take no mouse");
+            return;
+        }
+        objc2::ffi::object_setClass(view, sub);
+    }
+}
+
+/// `hitTest:` of GPUI's view: `nil` over a web view under the surface that
+/// nothing of nsh's covers, `NSView`'s answer elsewhere.
+unsafe extern "C-unwind" fn hit_test(this: *mut AnyObject, _cmd: Sel, point: CGPoint) -> *mut AnyObject {
+    let view = this as usize;
+    let through = std::panic::catch_unwind(move || {
+        // SAFETY: AppKit calls this on the main thread with the live view.
+        unsafe { passes(view as *mut AnyObject, point) }
+    })
+    .unwrap_or(false);
+    if through {
+        return ptr::null_mut();
+    }
+    // SAFETY: `this` is a live instance of a subclass of `NSView`.
+    unsafe { msg_send![super(this, class!(NSView)), hitTest: point] }
+}
+
+/// True when `point` (the superview's coordinates) is on a web view under
+/// a surface drawn in `view`.
+///
+/// # Safety
+///
+/// `view` is a live `NSView` (main thread).
+unsafe fn passes(view: *mut AnyObject, point: CGPoint) -> bool {
+    let surfaces: Vec<Rc<Surface>> = VIEWS.with_borrow(|views| {
+        views
+            .iter()
+            .filter(|(v, _)| *v == view as usize)
+            .filter_map(|(_, s)| s.upgrade())
+            .collect()
+    });
+    if surfaces.is_empty() {
+        return false;
+    }
+    // SAFETY: the caller's contract.
+    let (x, y) = unsafe {
+        let hidden: Bool = msg_send![view, isHidden];
+        if hidden.as_bool() {
+            return false;
+        }
+        let parent: *mut AnyObject = msg_send![view, superview];
+        let p: CGPoint = msg_send![view, convertPoint: point, fromView: parent];
+        let bounds: CGRect = msg_send![view, bounds];
+        let flipped: Bool = msg_send![view, isFlipped];
+        let y = if flipped.as_bool() {
+            p.y
+        } else {
+            bounds.size.height - p.y
+        };
+        (p.x as f32, y as f32)
+    };
+    let through = surfaces.iter().any(|surface| {
+        let (ox, oy) = surface.origin.get();
+        crate::input::web_under(surface, x - ox, y - oy)
+    });
+    if debug() {
+        // SAFETY: AppKit's shared application and its current event (main thread).
+        let kind: isize = unsafe {
+            let app: *mut AnyObject = msg_send![class!(NSApplication), sharedApplication];
+            let event: *mut AnyObject = msg_send![app, currentEvent];
+            if event.is_null() { -1 } else { msg_send![event, type] }
+        };
+        // Moves (5, 6) and tracking (8, 9) would flood the log.
+        if !matches!(kind, 5 | 6 | 8 | 9) {
+            log::warn!(
+                "web view: hitTest ({x:.0}, {y:.0}) event {kind} -> {}",
+                if through { "page" } else { "GPUI" }
+            );
+        }
+    }
+    through
+}
