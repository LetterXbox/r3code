+/// True when the innermost view at `(x, y)` (root coordinates) is a web
+/// view shown under the surface (macOS): the point is the page's, unless
+/// an overlay watches for presses outside it (the press is then nsh's, and
+/// dismisses it).
+pub(crate) fn web_under(surface: &Rc<Surface>, x: f32, y: f32) -> bool {
+    if surface.root.try_state().is_none() {
+        return false;
+    }
+    let Some(hit) = pick(&surface.root, x, y, false) else {
+        return false;
+    };
+    if hit.view.kind() != ViewKind::WebView || !crate::native::web_under(surface, hit.view.id()) {
+        return false;
+    }
+    !surface.root.state().events.contains(EventKind::Touch)
+}
