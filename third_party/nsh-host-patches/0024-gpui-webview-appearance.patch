diff --git a/crates/gpui/nsh-platform-gpui/src/native/appearance.rs b/crates/gpui/nsh-platform-gpui/src/native/appearance.rs
new file mode 100644
index 0000000..ab72b15
--- /dev/null
+++ b/crates/gpui/nsh-platform-gpui/src/native/appearance.rs
@@ -0,0 +1,55 @@
+//! `webview.appearance.set` (macOS, patch 0024): a colour-scheme override (`"system" | "light" | "dark"`) for
+//! every `WKWebView` currently shown, via `WKWebView.overrideUserInterfaceStyle`.
+//!
+//! Scope, decided here rather than guessed (mirrors `cookie_store.rs`'s decision for the same reason): this
+//! host's web views have no stable per-instance id a `host.call` could address (`webview.capture`, patch 0015,
+//! addresses one by on-screen point), and all of them share the one default `WKWebsiteDataStore` (no
+//! per-partition store exists, see `cookie_store.rs`). So `partition` is accepted and ignored; the override is
+//! applied to every web view `web::shown()` reports *right now*. A tab opened after this call starts at
+//! `overrideUserInterfaceStyle` unspecified (system) again: carrying the override forward to web views built
+//! later needs a stored default plumbed into `web.rs`'s builder, which this patch does not attempt (documented
+//! divergence, not silently narrowed away — `nativePreviewAdjust.ts`'s own comment already calls out the
+//! partition-vs-view-id gap this shares).
+
+use objc2::{msg_send, runtime::AnyObject};
+
+/// `WKWebView` is an `NSView`, so `NSResponder`'s `setAppearance:` (nil for "system", following the window) works
+/// on every macOS version this host ships on — simpler than `WKWebView.overrideUserInterfaceStyle` (macOS 13.3+
+/// only, and this tree has no typed WebKit binding to call it through without adding `objc2-web-kit`).
+fn ns_appearance(scheme: &str) -> *mut AnyObject {
+    // SAFETY: `NSAppearance` is AppKit, already linked (this host draws its own window with it).
+    unsafe {
+        match scheme {
+            "light" => msg_send![objc2::class!(NSAppearance), appearanceNamed: NSAppearanceNameAqua],
+            "dark" => msg_send![objc2::class!(NSAppearance), appearanceNamed: NSAppearanceNameDarkAqua],
+            _ => std::ptr::null_mut(),
+        }
+    }
+}
+
+#[link(name = "AppKit", kind = "framework")]
+unsafe extern "C" {
+    static NSAppearanceNameAqua: *const AnyObject;
+    static NSAppearanceNameDarkAqua: *const AnyObject;
+}
+
+/// `webview.appearance.set { partition, scheme }`.
+pub(super) fn set(data: serde_json::Value, call: nsh_engine::HostCall) {
+    let Some(scheme) = data.get("scheme").and_then(|v| v.as_str()) else {
+        call.reject("webview.appearance.set needs a scheme");
+        return;
+    };
+    if !matches!(scheme, "system" | "light" | "dark") {
+        call.reject("webview.appearance.set: scheme must be \"system\", \"light\" or \"dark\"");
+        return;
+    }
+    let appearance = ns_appearance(scheme);
+    for (webview_ptr, _webview, _geometry) in super::web::shown() {
+        // SAFETY: `webview_ptr` is a live `WKWebView` (kept alive by `_webview`, held by `shown()`'s caller until
+        // this loop returns); `setAppearance:` takes nil for "system" (follow the window's own appearance).
+        unsafe {
+            let _: () = msg_send![webview_ptr, setAppearance: appearance];
+        }
+    }
+    call.resolve(serde_json::Value::Null);
+}
